{
  "type": "object",
  "additionalProperties": false,
  "description": "Ordinary workloads implement the application-no-api profile: named account, no token, Restricted Pod Security, exact read-only mounts and no Kubernetes API access. Removal from the accepted catalog is deletion intent for owned workload objects; PVCs, databases, buckets and vault items are retained.",
  "properties": {
    "previewWaypoint": {
      "type": "boolean"
    },
    "previewIdentity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "instance": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "approvalDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "runtimeStateUID": {
          "type": "string",
          "pattern": "^[a-z0-9-]{1,64}$"
        }
      },
      "required": [
        "instance",
        "approvalDigest",
        "runtimeStateUID"
      ]
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,40}$",
      "not": {
        "const": "default"
      }
    },
    "owner": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,40}$"
    },
    "image": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9./:_-]+@sha256:[a-f0-9]{64}$"
    },
    "replicas": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "artifactPolicyHash": {
      "type": "string",
      "pattern": "^([a-f0-9]{64})?$"
    },
    "command": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true
    },
    "ports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,40}$"
          },
          "port": {
            "type": "integer",
            "minimum": 1024,
            "maximum": 65535
          }
        },
        "required": [
          "name",
          "port"
        ]
      },
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "readiness": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^/[A-Za-z0-9/_-]*$"
            },
            "port": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,40}$"
            }
          },
          "required": [
            "path",
            "port"
          ]
        },
        "liveness": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^/[A-Za-z0-9/_-]*$"
            },
            "port": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,40}$"
            }
          },
          "required": [
            "path",
            "port"
          ]
        }
      },
      "required": [
        "readiness",
        "liveness"
      ]
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cpu": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,3}m$"
            },
            "memory": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,4}Mi$"
            }
          },
          "required": [
            "cpu",
            "memory"
          ]
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cpu": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,3}m$"
            },
            "memory": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,4}Mi$"
            }
          },
          "required": [
            "cpu",
            "memory"
          ]
        }
      },
      "required": [
        "requests",
        "limits"
      ]
    },
    "environment": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]*$"
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 4096
      }
    },
    "secrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,40}$"
          },
          "mountPath": {
            "type": "string",
            "pattern": "^/(secrets|config|tls)/[a-z0-9-]+$"
          },
          "containers": {
            "type": "array",
            "description": "Receiving containers; defaults to the application container only.",
            "items": {
              "enum": [
                "application",
                "dependencies"
              ]
            },
            "minItems": 1,
            "maxItems": 2,
            "uniqueItems": true
          }
        },
        "required": [
          "name",
          "mountPath"
        ]
      },
      "minItems": 0,
      "maxItems": 16,
      "uniqueItems": true
    },
    "configMaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,40}$"
          },
          "mountPath": {
            "type": "string",
            "pattern": "^/(secrets|config|tls)/[a-z0-9-]+$"
          },
          "containers": {
            "type": "array",
            "description": "Receiving containers; defaults to both application and dependencies containers.",
            "items": {
              "enum": [
                "application",
                "dependencies"
              ]
            },
            "minItems": 1,
            "maxItems": 2,
            "uniqueItems": true
          }
        },
        "required": [
          "name",
          "mountPath"
        ]
      },
      "minItems": 0,
      "maxItems": 16,
      "uniqueItems": true
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "size": {
          "type": "string",
          "pattern": "^[1-9][0-9]?Gi$"
        },
        "mountPath": {
          "type": "string",
          "pattern": "^/data(/[a-z0-9-]+)?$"
        },
        "retention": {
          "const": "retain"
        }
      },
      "required": [
        "enabled",
        "size",
        "mountPath",
        "retention"
      ]
    },
    "exposure": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "class": {
              "const": "none"
            }
          },
          "required": [
            "class"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "class": {
              "enum": [
                "public",
                "private"
              ]
            },
            "hostname": {
              "type": "string",
              "pattern": "^[a-z0-9.-]+$"
            },
            "access": {
              "enum": [
                "public",
                "human",
                "machine",
                "tailnet"
              ]
            },
            "path": {
              "type": "string",
              "pattern": "^/[A-Za-z0-9/_-]*$"
            },
            "port": {
              "type": "integer",
              "minimum": 1024,
              "maximum": 65535
            }
          },
          "required": [
            "class"
          ],
          "description": "Ordinary services carry the class signal only; addresses arrive via exposureFile and privateExposures."
        }
      ]
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "database": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,62}$"
            },
            "credentialReference": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,40}$"
            },
            "retention": {
              "const": "retain"
            }
          },
          "required": [
            "name",
            "credentialReference",
            "retention"
          ]
        },
        "bucket": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,40}$"
            },
            "credentialReference": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,40}$"
            },
            "retention": {
              "const": "retain"
            }
          },
          "required": [
            "name",
            "credentialReference",
            "retention"
          ]
        }
      },
      "required": []
    },
    "oidc": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "const": false
            }
          },
          "required": [
            "enabled"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "const": true
            },
            "realm": {
              "const": "applications"
            },
            "client": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,40}$"
            },
            "public": {
              "type": "boolean"
            },
            "callbackPaths": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^/[A-Za-z0-9/_-]*$"
              },
              "minItems": 1,
              "maxItems": 8,
              "uniqueItems": true
            },
            "audience": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,40}$"
            },
            "scopes": {
              "type": "array",
              "items": {
                "enum": [
                  "profile",
                  "email"
                ]
              },
              "minItems": 1,
              "maxItems": 2,
              "uniqueItems": true
            },
            "roleMapping": {
              "type": "object",
              "minProperties": 1,
              "maxProperties": 8,
              "propertyNames": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,40}$"
              },
              "additionalProperties": {
                "type": "array",
                "items": {
                  "enum": [
                    "platform-admin",
                    "developer",
                    "viewer"
                  ]
                },
                "minItems": 1,
                "maxItems": 3,
                "uniqueItems": true
              }
            },
            "secretReference": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,40}$"
            }
          },
          "required": [
            "enabled",
            "realm",
            "client",
            "public",
            "callbackPaths",
            "audience",
            "scopes",
            "roleMapping"
          ]
        }
      ]
    },
    "monitoring": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "routes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 96,
            "pattern": "^/([A-Za-z0-9_-]+|:[a-z][a-z0-9_]*)(/([A-Za-z0-9_-]+|:[a-z][a-z0-9_]*))*$|^/$"
          }
        },
        "metrics": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "enabled"
              ],
              "properties": {
                "enabled": {
                  "const": false
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "enabled",
                "profile",
                "endpoints"
              ],
              "properties": {
                "enabled": {
                  "const": true
                },
                "profile": {
                  "const": "cloudlab-http"
                },
                "endpoints": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "port",
                      "path"
                    ],
                    "properties": {
                      "port": {
                        "const": "http-metrics"
                      },
                      "path": {
                        "const": "/metrics"
                      }
                    }
                  }
                }
              }
            }
          ]
        },
        "logs": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "enabled"
              ],
              "properties": {
                "enabled": {
                  "const": false
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "enabled",
                "profile"
              ],
              "properties": {
                "enabled": {
                  "const": true
                },
                "profile": {
                  "const": "cloudlab-http-json-v1"
                }
              }
            }
          ]
        },
        "traces": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Generic service traces require qualified ambient workload attribution; metrics and logs are supported."
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "routes"
            ],
            "anyOf": [
              {
                "required": [
                  "metrics"
                ],
                "properties": {
                  "metrics": {
                    "properties": {
                      "enabled": {
                        "const": true
                      }
                    }
                  }
                }
              },
              {
                "required": [
                  "logs"
                ],
                "properties": {
                  "logs": {
                    "properties": {
                      "enabled": {
                        "const": true
                      }
                    }
                  }
                }
              }
            ]
          },
          "else": {
            "properties": {
              "metrics": {
                "properties": {
                  "enabled": {
                    "const": false
                  }
                }
              },
              "logs": {
                "properties": {
                  "enabled": {
                    "const": false
                  }
                }
              }
            }
          }
        }
      ]
    },
    "rollouts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "enabled"
      ]
    },
    "apiToken": {
      "type": "object",
      "additionalProperties": false,
      "description": "Approved API clients receive a short-lived, audience-bound token in the application container only; admission denies other projections.",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "audience": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,40}$"
        },
        "expirationSeconds": {
          "type": "integer",
          "minimum": 600,
          "maximum": 3600
        }
      },
      "required": [
        "enabled"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "audience",
              "expirationSeconds"
            ]
          }
        }
      ]
    },
    "dnsConfig": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "description": "Accepted DNS resolvers for workload pods, or null for cluster defaults.",
      "properties": {
        "nameservers": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(([0-9]{1,3}\\.){3}[0-9]{1,3}|[0-9a-fA-F:]+)$"
          },
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true
        }
      },
      "required": [
        "nameservers"
      ]
    },
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "description": "Dormant default-deny NetworkPolicy for workload pods; activation awaits declared dependencies.",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "enabled"
      ]
    },
    "initCommand": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string"
      }
    },
    "global": {
      "type": "object",
      "additionalProperties": false
    },
    "additionalExposures": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "class": {
            "const": "private"
          },
          "hostname": {
            "type": "string",
            "pattern": "^[a-z0-9.-]+$"
          },
          "access": {
            "enum": [
              "public",
              "human",
              "machine",
              "tailnet"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^/[A-Za-z0-9/_-]*$"
          },
          "port": {
            "type": "integer",
            "minimum": 1024,
            "maximum": 65535
          }
        },
        "required": [
          "class",
          "hostname",
          "access",
          "path",
          "port"
        ]
      },
      "uniqueItems": true
    },
    "renderDisabled": {
      "type": "boolean"
    },
    "imagePullSecrets": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "const": "harbor-application-pull"
          }
        }
      }
    },
    "routeOnly": {
      "type": "boolean"
    },
    "routeBackends": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "service",
          "port",
          "selector"
        ],
        "properties": {
          "service": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,30}$"
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "selector": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 8,
            "additionalProperties": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9._-]{1,63}$"
            }
          },
          "readiness": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "statuses"
            ],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^/[a-zA-Z0-9/_-]{0,127}$"
              },
              "statuses": {
                "type": "array",
                "minItems": 1,
                "maxItems": 6,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    200,
                    204,
                    400,
                    401,
                    403
                  ]
                }
              }
            }
          }
        }
      },
      "minProperties": 0,
      "maxProperties": 8,
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9.-]{0,251}[a-z0-9]$"
      }
    },
    "exposureFile": {
      "type": [
        "object",
        "null"
      ],
      "description": "Validated public exposure entry injected per service, or null."
    },
    "privateExposures": {
      "type": "array",
      "description": "Validated private exposure entries injected per service."
    },
    "routeNames": {
      "type": "array",
      "description": "Ordinary managed HTTPRoute names injected per service."
    }
  },
  "required": [
    "name",
    "owner",
    "image",
    "replicas",
    "command",
    "ports",
    "health",
    "resources",
    "environment",
    "secrets",
    "configMaps",
    "persistence",
    "exposure",
    "data",
    "oidc",
    "monitoring",
    "rollouts",
    "initCommand"
  ],
  "$schema": "http://json-schema.org/draft-07/schema#",
  "allOf": [
    {
      "if": {
        "properties": {
          "exposure": {
            "properties": {
              "class": {
                "const": "none"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "additionalExposures": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
