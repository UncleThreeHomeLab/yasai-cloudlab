+package zero_trust_access_application
+
+import (
+    "bytes"
+    "context"
+    "testing"
+    "github.com/cloudflare/terraform-provider-cloudflare/internal/apijson"
+)
+
+func TestLegacyImportPreservesIDAndSelectors(t *testing.T) {
+    data := new(ZeroTrustAccessApplicationModel)
+    raw := []byte(`{"policies":[{"id":"00000000-0000-4000-8000-000000000001","reusable":false,"name":"legacy","decision":"allow","precedence":1,"include":[{"email":{"email":"allowed@example.invalid"}}],"require":[{"oidc":{"claim_name":"groups","claim_value":"members","identity_provider_id":"00000000-0000-4000-8000-000000000002"}}]}]}`)
+    if err := apijson.Unmarshal(raw, data); err != nil { t.Fatal(err) }
+    if diags := normalizeImportZeroTrustAccessApplicationAPIData(context.Background(), data); diags.HasError() { t.Fatal(diags) }
+    policy := (*data.Policies)[0]
+    if policy.ID.ValueString() != "00000000-0000-4000-8000-000000000001" || policy.Name.ValueString() != "legacy" || len(policy.Include.Elements()) != 1 || len(policy.Require.Elements()) != 1 || policy.Reusable.ValueBool() { t.Fatal("legacy import discarded identity or selectors") }
+    body, err := apijson.MarshalRoot(policy)
+    if err != nil { t.Fatal(err) }
+    if !bytes.Contains(body, []byte(`"id"`)) || !bytes.Contains(body, []byte(`"include"`)) || bytes.Contains(body, []byte(`"reusable"`)) { t.Fatal("request must preserve policy ID and omit computed lifecycle metadata") }
+}
+
+func TestReusableImportKeepsReferenceOwnership(t *testing.T) {
+    data := new(ZeroTrustAccessApplicationModel)
+    if err := apijson.Unmarshal([]byte(`{"policies":[{"id":"00000000-0000-4000-8000-000000000001","reusable":true,"name":"external","decision":"allow","include":[{"email":{"email":"allowed@example.invalid"}}]}]}`), data); err != nil { t.Fatal(err) }
+    if diags := normalizeImportZeroTrustAccessApplicationAPIData(context.Background(), data); diags.HasError() { t.Fatal(diags) }
+    policy := (*data.Policies)[0]
+    if policy.ID.IsNull() || !policy.Include.IsNull() || !policy.Name.IsNull() || !policy.Reusable.ValueBool() { t.Fatal("reusable policy must retain independent ownership") }
+}
