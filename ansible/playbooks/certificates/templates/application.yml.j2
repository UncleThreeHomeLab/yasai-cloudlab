apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: cloudlab-certificates
  namespace: argocd
{% if certificates_current.metadata.uid is defined %}
  uid: {{ certificates_current.metadata.uid | to_json }}
{% endif %}
  labels:
    cloudlab.io/owner: {{ certificates_owner }}
spec:
  project: cloudlab-certificates
  source:
    repoURL: {{ certificates_source.repository | to_json }}
    targetRevision: {{ certificates_source.branch | to_json }}
    path: platform/certificates/configuration
    helm:
      releaseName: cloudlab-certificates
      valuesObject:
        zone: {{ certificates_zone | to_json }}
        production: {{ certificates_production | to_json }}
  destination:
    server: https://kubernetes.default.svc
    namespace: cert-manager
  syncPolicy:
    automated: {enabled: true, prune: false, selfHeal: true, allowEmpty: false}
    syncOptions:
      - FailOnSharedResource=true
      - DisableClientSideApplyMigration=true
    retry:
      limit: 5
      backoff: {duration: 5s, factor: 2, maxDuration: 1m}
