REVOKE CONNECT ON DATABASE postgres FROM PUBLIC;
REVOKE CONNECT ON DATABASE template1 FROM PUBLIC;
REVOKE ALL ON DATABASE "{{ data_sql_database.name }}" FROM PUBLIC;
GRANT CONNECT ON DATABASE "{{ data_sql_database.name }}"
    TO "{{ data_sql_database.applicationRole }}", "{{ data_sql_database.migrationRole }}", "{{ data_native_values.backupRole }}";
REVOKE ALL ON SCHEMA public FROM PUBLIC;
GRANT USAGE ON SCHEMA public TO "{{ data_sql_database.applicationRole }}", "{{ data_native_values.backupRole }}";
GRANT USAGE, CREATE ON SCHEMA public TO "{{ data_sql_database.migrationRole }}";
GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA public TO "{{ data_sql_database.applicationRole }}";
GRANT USAGE, SELECT ON ALL SEQUENCES IN SCHEMA public TO "{{ data_sql_database.applicationRole }}";
GRANT SELECT ON ALL TABLES IN SCHEMA public TO "{{ data_native_values.backupRole }}";
GRANT SELECT ON ALL SEQUENCES IN SCHEMA public TO "{{ data_native_values.backupRole }}";
ALTER DEFAULT PRIVILEGES FOR ROLE "{{ data_sql_database.migrationRole }}" IN SCHEMA public
    GRANT SELECT, INSERT, UPDATE, DELETE ON TABLES TO "{{ data_sql_database.applicationRole }}";
ALTER DEFAULT PRIVILEGES FOR ROLE "{{ data_sql_database.migrationRole }}" IN SCHEMA public
    GRANT USAGE, SELECT ON SEQUENCES TO "{{ data_sql_database.applicationRole }}";
ALTER DEFAULT PRIVILEGES FOR ROLE "{{ data_sql_database.migrationRole }}" IN SCHEMA public
    GRANT SELECT ON TABLES TO "{{ data_native_values.backupRole }}";
ALTER DEFAULT PRIVILEGES FOR ROLE "{{ data_sql_database.migrationRole }}" IN SCHEMA public
    GRANT SELECT ON SEQUENCES TO "{{ data_native_values.backupRole }}";
