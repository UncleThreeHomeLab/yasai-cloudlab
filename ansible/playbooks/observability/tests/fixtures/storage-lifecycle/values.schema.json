{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operationId",
    "phase"
  ],
  "properties": {
    "operationId": {
      "type": "string",
      "pattern": "^[a-f0-9]{16}$"
    },
    "phase": {
      "type": "string",
      "enum": [
        "running",
        "scaled-down",
        "removed"
      ]
    }
  }
}
