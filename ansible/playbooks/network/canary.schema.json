{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Prices network canary declaration (dormant)",
  "description": "Dormant offline shape for the bounded Prices network-canary intent. Not referenced by any play, template, values file, or reconciler; creates no NetworkPolicy, AuthorizationPolicy, or egress rule. Normative render paths stay platform/delivery/services/templates/composition-network.yaml, egress.yaml, and _egress.tpl. Activation needs a separately reviewed change through the owning services/network owners.",
  "$comment": "T6/R8: one declared dependency (allow) plus one forbidden destination (deny, renders no rule). Retired yields empty rules/egress. Off-cluster egress is unsupported scope (D3): the dormant path stays dormant, no new external control claimed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "status",
    "scope",
    "canary",
    "offCluster",
    "owners",
    "blocked"
  ],
  "properties": {
    "version": {
      "const": "cloudlab-network-canary/v1"
    },
    "status": {
      "const": "dormant"
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "canary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allow",
        "forbid",
        "egress",
        "retired"
      ],
      "properties": {
        "allow": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "destination",
            "ports"
          ],
          "properties": {
            "source": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,30}$"
            },
            "destination": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,30}$"
            },
            "ports": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              }
            }
          }
        },
        "forbid": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "destination"
          ],
          "properties": {
            "destination": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,30}$"
            }
          }
        },
        "egress": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cidr"
          ],
          "properties": {
            "cidr": {
              "type": "string",
              "pattern": "^((25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])/(9|[12][0-9]|3[0-2])$"
            },
            "except": {
              "type": "array",
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "maxLength": 18
              }
            }
          }
        },
        "retired": {
          "type": "boolean"
        }
      }
    },
    "offCluster": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disposition",
        "detail"
      ],
      "properties": {
        "disposition": {
          "const": "unsupported"
        },
        "detail": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "owners": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fieldOwner",
        "reconciler",
        "credentials",
        "deletionPolicy"
      ],
      "properties": {
        "fieldOwner": {
          "type": "string",
          "minLength": 1
        },
        "reconciler": {
          "type": "string",
          "minLength": 1
        },
        "credentials": {
          "type": "string",
          "minLength": 1
        },
        "deletionPolicy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "blocked": {
      "type": "string",
      "minLength": 1
    },
    "acceptance": {
      "type": "string"
    }
  }
}
