apiVersion: external-secrets.io/v1
kind: ClusterSecretStore
metadata:
  name: {{ external_secrets_store }}
  annotations:
    cloudlab.io/credential-revision: {{ external_secrets_token | hash('sha256') | to_json }}
spec:
  conditions:
    - namespaces: [external-secrets, longhorn-system]
  provider:
    onepasswordSDK:
      vault: {{ external_secrets_vault | to_json }}
      auth:
        serviceAccountSecretRef:
          name: onepassword-token
          namespace: external-secrets
          key: token
