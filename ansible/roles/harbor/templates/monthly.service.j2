[Unit]
Description=Coordinated monthly Harbor export and isolated restore
After=k3s.service network-online.target
Wants=network-online.target
ConditionPathExists=/opt/cloudlab/platform/harbor/policy.json

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/cloudlab/automation/harbor/recovery.py monthly
UMask=0077
TimeoutStartSec=4h
Nice=10
MemoryMax=1G
CPUQuota=100%
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/cloudlab/harbor /run/lock
ReadOnlyPaths=/etc/rancher/k3s
