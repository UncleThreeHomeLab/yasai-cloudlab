+package provider
+
+import (
+	"fmt"
+	"github.com/goharbor/terraform-provider-harbor/client"
+	"github.com/hashicorp/terraform-plugin-sdk/v2/helper/schema"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+)
+
+func TestCloudlabQuotaRefreshImportAndFailure(t *testing.T) {
+	for _, tc := range []struct {
+		name, body string
+		code       int
+		valid      bool
+	}{
+		{"bounded", `[{"id":7,"ref":{"id":1},"hard":{"storage":21474836480}}]`, 200, true},
+		{"unlimited", `[{"id":7,"ref":{"id":1},"hard":{"storage":-1}}]`, 200, true},
+		{"missing", `[]`, 200, false},
+		{"foreign", `[{"id":7,"ref":{"id":2},"hard":{"storage":21474836480}}]`, 200, false},
+		{"fractional", `[{"id":7,"ref":{"id":1},"hard":{"storage":1}}]`, 200, false},
+		{"denied", `{}`, 403, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				switch r.URL.Path {
+				case "/projects/1":
+					fmt.Fprint(w, `{"project_id":1,"name":"fixture","metadata":{}}`)
+				case "/quotas":
+					if r.URL.Query().Get("reference_id") != "1" || r.URL.Query().Get("reference") != "project" {
+						t.Error("unscoped quota query")
+					}
+					w.WriteHeader(tc.code)
+					fmt.Fprint(w, tc.body)
+				default:
+					t.Error("unexpected API path")
+					w.WriteHeader(500)
+				}
+			}))
+			defer server.Close()
+			api := client.NewClient(server.URL, "synthetic", "synthetic", "", "", false, "robot$", nil)
+			data := schema.TestResourceDataRaw(t, resourceProject().Schema, map[string]interface{}{})
+			data.SetId("/projects/1")
+			err := resourceProjectRead(data, api)
+			if (err == nil) != tc.valid {
+				t.Fatalf("unexpected refresh/import result: %v", err)
+			}
+			if tc.valid && tc.name == "bounded" && data.Get("storage_quota").(int) != 20 {
+				t.Fatal("quota was not refreshed")
+			}
+			if tc.valid && tc.name == "unlimited" && data.Get("storage_quota").(int) != -1 {
+				t.Fatal("unlimited quota changed")
+			}
+		})
+	}
+}
+
+func TestCloudlabQuotaUpdateFailurePropagates(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		switch {
+		case r.Method == "PUT" && r.URL.Path == "/projects/1":
+			w.WriteHeader(200)
+		case r.Method == "GET" && r.URL.Path == "/quotas":
+			fmt.Fprint(w, `[{"id":7,"ref":{"id":1},"hard":{"storage":1073741824}}]`)
+		case r.Method == "PUT" && r.URL.Path == "/quotas/7":
+			w.WriteHeader(500)
+		default:
+			t.Error("unexpected API call after quota failure")
+			w.WriteHeader(500)
+		}
+	}))
+	defer server.Close()
+	data := schema.TestResourceDataRaw(t, resourceProject().Schema, map[string]interface{}{"name": "fixture", "storage_quota": 20})
+	data.SetId("/projects/1")
+	api := client.NewClient(server.URL, "synthetic", "synthetic", "", "", false, "robot$", nil)
+	if resourceProjectUpdate(data, api) == nil {
+		t.Fatal("failed quota update was silently accepted")
+	}
+}
