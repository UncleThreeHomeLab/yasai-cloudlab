+package provider
+
+import (
+	"fmt"
+	"github.com/goharbor/terraform-provider-harbor/client"
+	"github.com/hashicorp/terraform-plugin-sdk/v2/helper/schema"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+)
+
+func TestCloudlabRobotPermissionRead(t *testing.T) {
+	for _, tc := range []struct {
+		name, effect      string
+		configured, valid bool
+	}{
+		{"import-allow", "allow", false, true}, {"refresh-deny", "deny", true, true},
+		{"missing-effect", "", true, false}, {"unsupported-effect", "other", true, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			calls := 0
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				calls++
+				if r.Method != "GET" || r.URL.Path != "/robots/7" {
+					t.Error("permission refresh attempted a write or another identity")
+					w.WriteHeader(500)
+					return
+				}
+				fmt.Fprintf(w, `{"id":7,"name":"robot$fixture+pull","level":"project","duration":-1,"permissions":[{"kind":"project","namespace":"fixture","access":[{"action":"pull","resource":"repository","effect":%q}]}]}`, tc.effect)
+			}))
+			defer server.Close()
+			input := map[string]interface{}{}
+			if tc.configured {
+				input["permissions"] = []interface{}{map[string]interface{}{"kind": "project", "namespace": "fixture", "access": []interface{}{map[string]interface{}{"action": "pull", "resource": "repository", "effect": "allow"}}}}
+			}
+			data := schema.TestResourceDataRaw(t, resourceRobotAccount().Schema, input)
+			data.SetId("/robots/7")
+			api := client.NewClient(server.URL, "synthetic", "synthetic", "", "", false, "robot$", nil)
+			err := resourceRobotAccountRead(data, api)
+			if (err == nil) != tc.valid {
+				t.Fatalf("unexpected refresh/import result: %v", err)
+			}
+			if calls != 1 {
+				t.Fatal("refresh must use exactly one read")
+			}
+			if tc.valid {
+				permission := data.Get("permissions").(*schema.Set).List()[0].(map[string]interface{})
+				access := permission["access"].(*schema.Set).List()[0].(map[string]interface{})
+				if access["effect"] != tc.effect {
+					t.Fatal("configured allow masked server effect or import lost it")
+				}
+			}
+		})
+	}
+}
