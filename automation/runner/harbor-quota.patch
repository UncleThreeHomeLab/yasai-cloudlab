+// ProjectStorageQuota resolves exactly one quota for the project, including refresh and import.
+func (client *Client) ProjectStorageQuota(project string) (models.QuotaResponse, error) {
+	var empty models.QuotaResponse
+	id, err := strconv.Atoi(strings.TrimPrefix(project, "/projects/"))
+	if err != nil || id <= 0 || !strings.HasPrefix(project, "/projects/") {
+		return empty, fmt.Errorf("invalid project quota identity")
+	}
+	path := fmt.Sprintf("/quotas?reference=project&reference_id=%d&page=1&page_size=2", id)
+	resp, _, _, err := client.SendRequest("GET", path, nil, 200)
+	if err != nil {
+		return empty, err
+	}
+	var rows []models.QuotaResponse
+	if err := json.Unmarshal([]byte(resp), &rows); err != nil {
+		return empty, err
+	}
+	if len(rows) != 1 || rows[0].Ref.ID != id || rows[0].ID <= 0 || rows[0].Hard.Storage < -1 {
+		return empty, fmt.Errorf("project quota identity or limit is missing or ambiguous")
+	}
+	return rows[0], nil
+}
