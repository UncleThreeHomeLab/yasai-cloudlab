variable "registry" {
  description = "Compiled reviewed registry binding (registry.py compile output). Authorizes quota and memberships only; no project, robot, retention, or deletion change."
  type = object({
    projects       = map(number)
    memberships    = map(object({ project = string, group = string, role = string }))
    protected_tags = string
    retention      = string
  })
  validation {
    condition     = toset(keys(var.registry.projects)) == toset(["cloudlab-public", "cloudlab-private"])
    error_message = "Only the two existing registry projects are supported; a binding authorizes no new project."
  }
  validation {
    condition     = alltrue([for quota in values(var.registry.projects) : quota >= 1 && quota <= 100 && floor(quota) == quota])
    error_message = "Project quotas are whole GiB between 1 and 100."
  }
  validation {
    condition     = var.registry.protected_tags == "{release-*,deploy-*,rollback-*}" && var.registry.retention == "retain-all"
    error_message = "Immutable tags and artifact retention stay at their accepted preservation policy."
  }
  validation {
    condition = alltrue([for member in values(var.registry.memberships) :
      contains(["cloudlab-public", "cloudlab-private"], member.project)
      && contains(["/platform-admin", "/developer", "/viewer"], member.group)
      && contains(["projectadmin", "developer", "guest"], member.role)
      ]) && alltrue([for project in keys(var.registry.projects) :
      contains([for member in values(var.registry.memberships) : member.role
      if member.project == project && member.group == "/platform-admin"], "projectadmin")
      ]) && alltrue([for project in keys(var.registry.projects) :
      length(distinct([for member in values(var.registry.memberships) : member.role
      if member.project == project]))
      == length([for member in values(var.registry.memberships) : member.role
      if member.project == project])
    ])
    error_message = "Memberships use approved groups and roles, keep one group per role, and retain the platform administrator."
  }
}

variable "robot_secrets" {
  description = "Existing durable vault inputs; never generated by the provider or persisted in state."
  type        = map(string)
  sensitive   = true
  ephemeral   = true
  validation {
    condition     = toset(keys(var.robot_secrets)) == toset(keys(local.robots)) && alltrue([for value in values(var.robot_secrets) : length(value) >= 32])
    error_message = "All four scoped robot passwords must exist durably in the vault before creation."
  }
}
