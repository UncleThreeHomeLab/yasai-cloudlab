# yasai-cloudlab — lab VM
# Copy this file to .env for VM access and the 1Password bootstrap token only.
# Application secrets, including all B2 values, belong in 1Password. .env is gitignored.

# SSH target. IP or DNS name.
VM_HOST=
# SSH login user (root, or an existing user with sudo access).
VM_USER=root
# Login password. Keep the real value only in .env.
VM_PASSWORD=
# Optional SSH port. Defaults to 22.
VM_PORT=22
# Optional sudo password. Defaults to VM_PASSWORD; unused for root/passwordless sudo.
VM_BECOME_PASSWORD=

# Second VM: the K3s worker. Both VM credential sets are required.
# SSH target. IP or DNS name.
VM2_HOST=
# SSH login user. Change this if the second VM uses another account.
VM2_USER=root
# Login password. Keep the real value only in .env.
VM2_PASSWORD=
# Optional SSH port. Defaults to 22.
VM2_PORT=22
# Optional sudo password. Defaults to VM2_PASSWORD; unused for root/passwordless sudo.
VM2_BECOME_PASSWORD=

# B2 values live in CloudLab/longhorn-b2 in 1Password.

# Required for apply/prove/verify: 1Password service account with Read Items access
# to CloudLab only. Automation creates the Kubernetes bootstrap Secret.
OP_SERVICE_ACCOUNT_TOKEN=

# Optional local provisioning identity: CloudLab-only Read Items + Write Items.
# Create a separate service account; existing account permissions are immutable.
# Keep the read-only token above for ESO. Never send this writer token to the VMs
# or Kubernetes. Supplying it authorizes task-scoped creation of missing items;
# existing secrets are preserved. No vault creation or item sharing is needed.
OP_PROVISION_SERVICE_ACCOUNT_TOKEN=

# GitOps requires verified host access and early recovery. Provision the scoped
# external host-access and recovery credentials before bootstrap.
TAILSCALE_HOSTS_ENABLED=1
TAILSCALE_ADMIN_LOGIN=
# Enable after the shared B2 item and restic password are available.
K3S_BACKUP_ENABLED=1

# Explicit external repository setup only; not needed by apply/prove/public GitOps.
# Existing gh authentication may instead supply the provisioning token on stdin.
GITHUB_PROVISION_TOKEN=
# Exact designated HTTPS URLs ending in .git. Keep actual private inputs off Git.
PRIVATE_CONFIG_REPOSITORY=
PUBLIC_TEST_REPOSITORY=
PRIVATE_TEST_REPOSITORY=

# Optional private GitOps roots; keep actual values only in .env. Default: none.
# JSON list of {"name":"...","repository":"https://github.com/.../...git","revision":"main","path":"..."}.
# Each root receives a dedicated cloudlab-private-<name> namespace and project.
# Credentials: CloudLab/github-argocd fields APP_ID, INSTALLATION_ID, PRIVATE_KEY.
# Removing an entry retains its resources; removal requires the explicit removal action.
PRIVATE_GITOPS_SOURCES=[]
# Explicit removal action only: select a name already removed from the list above.
PRIVATE_GITOPS_REMOVE=

# Access preparation only: access-preflight reads prerequisites without mutation.
# CloudLab/tailscale-operator: CLIENT_ID, CLIENT_SECRET; Devices Core, Auth Keys
# and Services Write, scoped to tag:cloudlab-operator.
# Existing tailscale-policy additionally needs DNS Read/Write for private split DNS.
# Existing Cloudflare tunnel remains pre-provisioned; no vault writer is selected.
# CloudLab/cloudflare-access-machine: SERVICE_TOKEN_ID, CLIENT_ID, CLIENT_SECRET.
# Human Access defaults to TAILSCALE_ADMIN_LOGIN; other users need explicit approval.
CLOUDFLARE_HUMAN_EMAIL=
# Existing Cloudflare one-time PIN identity provider ID, not an API credential.
CLOUDFLARE_IDP_ID=
# Explicit hostname labels under the certificate zone; no real zone in Git.
CLOUDFLARE_ACCESS_HOSTS=[]
# Private labels under internal.<certificate-zone>; never publish their DNS records.
PRIVATE_ACCESS_HOSTS=[]
# Set only after confirming existing Personal/Zero Trust Free eligibility.
ACCESS_FREE_TIER_CONFIRMED=0
