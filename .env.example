# yasai-cloudlab — lab VM
# Copy this file to .env for VM access and the 1Password bootstrap token only.
# Application secrets, including all B2 values, belong in 1Password. .env is gitignored.

# SSH target. IP or DNS name.
VM_HOST=
# SSH login user (root, or an existing user with sudo access).
VM_USER=root
# Login password. Keep the real value only in .env.
VM_PASSWORD=
# Optional SSH port. Defaults to 22.
VM_PORT=22
# Optional sudo password. Defaults to VM_PASSWORD; unused for root/passwordless sudo.
VM_BECOME_PASSWORD=

# Second VM: the K3s worker. Both VM credential sets are required.
# SSH target. IP or DNS name.
VM2_HOST=
# SSH login user. Change this if the second VM uses another account.
VM2_USER=root
# Login password. Keep the real value only in .env.
VM2_PASSWORD=
# Optional SSH port. Defaults to 22.
VM2_PORT=22
# Optional sudo password. Defaults to VM2_PASSWORD; unused for root/passwordless sudo.
VM2_BECOME_PASSWORD=

# B2 values live in CloudLab/longhorn-b2 in 1Password.

# Required for setup/prove/verify: 1Password service account with Read Items access
# to CloudLab only. Automation creates the Kubernetes bootstrap Secret.
OP_SERVICE_ACCOUNT_TOKEN=

# Optional local provisioning identity: CloudLab-only Read Items + Write Items.
# Create a separate service account; existing account permissions are immutable.
# Keep the read-only token above for ESO. Never send this writer token to the VMs
# or Kubernetes. Supplying it authorizes task-scoped creation of missing items;
# existing secrets are preserved. No vault creation or item sharing is needed.
OP_PROVISION_SERVICE_ACCOUNT_TOKEN=

# GitOps requires verified host access and early recovery. Provision the scoped
# external host-access and recovery credentials before bootstrap.
TAILSCALE_HOSTS_ENABLED=1
TAILSCALE_ADMIN_LOGIN=
# Enable after the shared B2 item and restic password are available.
K3S_BACKUP_ENABLED=1
# Optional reviewed workload sysctl names. Only [] or ["net.ipv6.conf.all.disable_ipv6"] is supported.
# K3s owns node enablement; workload admission must separately approve the name and value.
K3S_ALLOWED_UNSAFE_SYSCTLS=[]

# Explicit external repository setup only; not needed by setup/prove/public GitOps.
# Existing gh authentication may instead supply the provisioning token on stdin.
GITHUB_PROVISION_TOKEN=
# Exact designated HTTPS URLs ending in .git. Keep actual private inputs off Git.
PRIVATE_CONFIG_REPOSITORY=
# Bootstrap recovery only: exact private SHA recorded by a pending Argo identity binding.
KEYCLOAK_ARGO_RECOVERY_REVISION=

# Connectivity reconciliation only: the control-machine reconciler reads prerequisites without mutation.
# CloudLab/tailscale-operator: CLIENT_ID, CLIENT_SECRET; Devices Core, Auth Keys
# and Services Write, scoped to tag:cloudlab-operator.
# Existing tailscale-policy additionally needs DNS Read/Write for private split DNS.
# Existing Cloudflare tunnel remains pre-provisioned; no vault writer is selected.
# CloudLab/cloudflare-access-machine: SERVICE_TOKEN_ID, CLIENT_ID, CLIENT_SECRET.
# Human Access defaults to TAILSCALE_ADMIN_LOGIN; other users need explicit approval.
CLOUDFLARE_HUMAN_EMAIL=
# Existing Cloudflare one-time PIN identity provider ID, not an API credential.
CLOUDFLARE_IDP_ID=
# Private labels under internal.<certificate-zone>; never publish their DNS records.
# Include grafana and kiali for telemetry; harbor for the private registry.
PRIVATE_ACCESS_HOSTS=[]
# Set only after confirming existing Personal/Zero Trust Free eligibility.
ACCESS_FREE_TIER_CONFIRMED=0
# Standing connectivity reconciliation interval in seconds (60-86400).
CONNECTIVITY_INTERVAL=300

# Independent infrastructure client; use an absolute directory outside this checkout.
# No deployment credential or 1Password writer enters this client environment.
# Cloudflare root files: base.tfvars.json, backend.json, credentials.env,
# encryption.json. See ansible/playbooks/access/files/reconcile.py.
# Cloudflare credentials.env keeps CLOUDFLARE_API_TOKEN and TF_VAR_dns_api_token separate.
# GitHub credentials.env uses GITHUB_TOKEN and mounts only in independent infra-github.
# GitHub governance root files: backend.json, credentials.env, encryption.json,
# private.json. See infra/github-workflows/reconcile.py. backend.json carries
# {"project_id": "<gitlab state project>"}; credentials.env carries
# TF_HTTP_USERNAME, TF_HTTP_PASSWORD and GITHUB_TOKEN; encryption.json carries
# {"passphrase": "<32+ chars>"}; private.json carries the operator-declared
# private side {"private_repository": {"name", "id", "node_id"},
# "private_permissions": {"default_workflow_permissions": "read|write",
# "can_approve_pull_request_reviews": bool}}. The public side stays Git-owned.
# GitHub governance state and credentials never enter deployment jobs.
# Uptime root files: private.json. See platform/observability/reconcile.py.
# private.json carries {"notification_profiles": {"<approved-profile>": <contact-id>},
# "external_owner_status": {"roots": [{"name": "cloudflare|github", "enabled": bool}],
# "maximumObservationAgeSeconds": 60-86400}}. The UptimeRobot API key stays in
# the CloudLab/uptimerobot-management vault item (API_KEY), read locally only.
# Standing governance reconciliation interval in seconds (60-86400).
GOVERNANCE_INTERVAL=300
# Standing Harbor settings reconciliation interval in seconds (60-86400).
HARBOR_INTERVAL=300
# Standing independent uptime reconciliation interval in seconds (60-86400).
UPTIME_INTERVAL=300
# Standing backup protection reconciliation interval in seconds (60-86400).
PROTECTION_INTERVAL=600
# Standing dependency maintenance scheduler interval in seconds (60-86400).
MAINTENANCE_INTERVAL=3600
# Restrict .env and private input directories to your user; Compose cannot set host ACLs.
INFRA_PRIVATE_DIR=
# Optional local checkout backing the credential-reconciler's private
# declaration mount. Defaults to ../cloudlab-config next to this checkout.
PRIVATE_CONFIG_DIR=

# Optional local catalog staging file under docs/local; never a bootstrap dependency.
# Enabled services read versioned services/catalog.json from PRIVATE_CONFIG_REPOSITORY.
SERVICE_CATALOG_FILE=

# Optional previews read versioned previews/catalog.json from PRIVATE_CONFIG_REPOSITORY.
# Declare their single hostname through PRIVATE_ACCESS_HOSTS, then enable previews
# in the public root. Public PR discovery is anonymous. Private discovery derives
# bounded exact-repository read tokens locally from github-release-private.
# Its existing APP_ID, INSTALLATION_ID and PRIVATE_KEY stay in 1Password/local Compose.
# No operator, deployment, registry or identity-writer credential enters previews.
# Standing private-discovery refresh interval in seconds (60-86400, 0 runs once).
PREVIEW_DISCOVERY_INTERVAL=300

# Optional absolute local directory for dependency candidates, receipts and reports.
# Default: docs/local/dependency-work. Keep its contents private and out of Git.
DEPENDENCY_WORK_DIR=
