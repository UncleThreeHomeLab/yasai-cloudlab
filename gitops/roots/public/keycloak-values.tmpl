{{/* Parsed native inputs only. The owning handoff also verifies canonical CIDRs. */}}
{{- range $key, $_ := . -}}
{{- if not (has $key (list "installationRevision" "loginHost" "adminHost" "database" "databaseRole" "databaseHost" "databasePort" "databaseCA" "trustedProxyAddresses" "retiredEmergencyItem" "path")) -}}{{ fail "Identity installation input refused" }}{{- end -}}
{{- end -}}
{{- range $key := list "installationRevision" "loginHost" "adminHost" "database" "databaseRole" "databaseHost" "databaseCA" "retiredEmergencyItem" -}}
{{- if not (kindIs "string" (index $ $key)) -}}{{ fail "Identity installation input refused" }}{{- end -}}
{{- end -}}
{{- $dns := "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+$" -}}
{{- if or (ne .installationRevision "526891f62eb9b9a50a0ffaf6ef020269d09e7746") (not (hasPrefix "login." .loginHost)) (gt (len .loginHost) 240) (not (regexMatch $dns .loginHost)) (ne .adminHost (printf "identity-admin.internal.%s" (trimPrefix "login." .loginHost))) (not (regexMatch "^[a-z][a-z0-9_]{0,62}$" .database)) (not (regexMatch "^[a-z][a-z0-9_]{0,62}$" .databaseRole)) (ne .databaseHost "cloudlab-postgres-rw.cloudlab-data.svc.cluster.local") (eq .databaseCA "") (gt (len .databaseCA) 16384) (not (regexMatch "^keycloak-emergency-[a-f0-9]{32}$" .retiredEmergencyItem)) -}}
{{ fail "Identity installation input refused" }}
{{- end -}}
{{- range $identifier := list .database .databaseRole -}}
{{- if or (hasPrefix "pg_" $identifier) (has $identifier (list "postgres" "template0" "template1")) -}}{{ fail "Identity installation input refused" }}{{- end -}}
{{- end -}}
{{- if or (not (has (kindOf (index . "databasePort")) (list "float64" "int" "int64"))) (ne (toString .databasePort) "5432") (not (kindIs "slice" (index . "trustedProxyAddresses"))) -}}{{ fail "Identity installation input refused" }}{{- end -}}
{{- if or (lt (len .trustedProxyAddresses) 1) (gt (len .trustedProxyAddresses) 8) -}}{{ fail "Identity installation input refused" }}{{- end -}}
{{- $seen := list -}}
{{- range $cidr := .trustedProxyAddresses -}}
{{- if not (kindIs "string" $cidr) -}}{{ fail "Identity installation input refused" }}{{- end -}}
{{- if or (has $cidr $seen) (not (regexMatch "^([0-9]{1,3}\\.){3}[0-9]{1,3}/(2[4-9]|3[0-2])$" $cidr)) -}}{{ fail "Identity installation input refused" }}{{- end -}}
{{- $seen = append $seen $cidr -}}
{{- $parts := splitList "/" $cidr -}}{{- $octets := splitList "." (index $parts 0) -}}
{{- range $octet := $octets -}}
{{- if or (not (regexMatch "^(0|[1-9][0-9]{0,2})$" $octet)) (gt (atoi $octet) 255) -}}{{ fail "Identity installation input refused" }}{{- end -}}
{{- end -}}
{{- $first := atoi (index $octets 0) -}}{{- $second := atoi (index $octets 1) -}}
{{- $block := index (dict "24" 256 "25" 128 "26" 64 "27" 32 "28" 16 "29" 8 "30" 4 "31" 2 "32" 1) (index $parts 1) -}}
{{- if or (not (or (eq $first 10) (and (eq $first 172) (ge $second 16) (le $second 31)) (and (eq $first 192) (eq $second 168)))) (ne (mod (atoi (index $octets 3)) $block) 0) -}}{{ fail "Identity installation input refused" }}{{- end -}}
{{- end }}
