{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "identity": {
      "type": "object",
      "properties": {
        "application": {
          "type": "object", "additionalProperties": false,
          "required": ["enabled"],
          "properties": {"enabled": {"type": "boolean"}}
        }
      }
    },
    "privateSources": {
      "type": "object",
      "required": ["acceptanceCommitment"],
      "properties": {
        "acceptanceCommitment": {"type": "string", "pattern": "^([a-f0-9]{64})?$"}
      }
    }
  }
}
