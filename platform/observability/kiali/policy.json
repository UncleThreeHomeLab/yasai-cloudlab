{
  "namespace": "cloudlab-observability",
  "storage_class": "cloudlab-telemetry",
  "cpu_limit_millicores": 3000,
  "memory_limit_mib": 6144,
  "storage_limit_gib": 71,
  "prometheus": {
    "retention": "7d",
    "retention_size": "25GB",
    "pvc_gib": 30
  },
  "loki": {
    "retention": "72h",
    "pvc_gib": 20,
    "ingestion_rate_mb": 0.02,
    "ingestion_burst_mb": 0.1,
    "max_streams": 128
  },
  "tempo": {
    "retention": "24h",
    "pvc_gib": 15,
    "ingestion_rate_bytes": 60000,
    "max_trace_bytes": 65536
  },
  "grafana": {
    "pvc_gib": 5,
    "session_seconds": 300
  },
  "kiali": {
    "namespaces": [
      "cloudlab-app-notes",
      "istio-system",
      "cloudlab-observability",
      "cloudlab-gateway-public",
      "cloudlab-gateway-private",
      "argocd"
    ]
  },
  "identity_audit": {
    "retention_hours": 168,
    "batch_limit": 100,
    "interval_seconds": 300
  },
  "offsite_backup": false,
  "http_collection": {
    "interval": "30s",
    "timeout": "10s",
    "body_size_limit": "1MB",
    "sample_limit": 1000,
    "label_limit": 20,
    "label_name_length_limit": 64,
    "label_value_length_limit": 128,
    "target_limit": 8,
    "bucket_values": [
      "0.005",
      "0.01",
      "0.025",
      "0.05",
      "0.1",
      "0.25",
      "0.5",
      "1",
      "1.0",
      "2",
      "2.0",
      "5",
      "5.0",
      "10",
      "10.0",
      "+Inf"
    ]
  },
  "http_logs": {
    "max_line_size": "4KB",
    "rate": 2,
    "burst": 4,
    "duration_pattern": "^(0|[1-9][0-9]{0,5})([.][0-9]{1,3})?$",
    "error_codes": [
      "internal_error",
      "dependency_unavailable",
      "timeout"
    ]
  }
}
