{
  "kiali-server": {
    "login_token": {
      "signing_key": "secret:kiali-signing-key:key"
    },
    "kiali_feature_flags": {
      "disabled_features": [
        "logs-tab"
      ]
    },
    "auth": {
      "strategy": "openid",
      "openid": {
        "client_id": "kiali",
        "issuer_uri": "https://login.example.invalid/realms/platform",
        "username_claim": "sub",
        "disable_rbac": true
      }
    },
    "deployment": {
      "instance_name": "cloudlab-kiali",
      "image_version": "082246cfc99f69667f10e56cecd6b92d6c614908d29b123d93a0cd0173d0905f",
      "image_digest": "sha256",
      "cluster_wide_access": false,
      "view_only_mode": true,
      "resources": {
        "requests": {
          "cpu": "20m",
          "memory": "64Mi"
        },
        "limits": {
          "cpu": "200m",
          "memory": "384Mi"
        }
      },
      "discovery_selectors": {
        "default": [
          {
            "matchLabels": {
              "kubernetes.io/metadata.name": "cloudlab-app-notes"
            }
          },
          {
            "matchLabels": {
              "kubernetes.io/metadata.name": "istio-system"
            }
          },
          {
            "matchLabels": {
              "kubernetes.io/metadata.name": "cloudlab-observability"
            }
          },
          {
            "matchLabels": {
              "kubernetes.io/metadata.name": "cloudlab-gateway-public"
            }
          },
          {
            "matchLabels": {
              "kubernetes.io/metadata.name": "cloudlab-gateway-private"
            }
          }
        ]
      },
      "network_policy": {
        "enabled": false
      }
    },
    "clustering": {
      "autodetect_secrets": {
        "enabled": false
      }
    },
    "external_services": {
      "prometheus": {
        "url": "http://cloudlab-prometheus:9090"
      },
      "grafana": {
        "enabled": true,
        "internal_url": "http://cloudlab-grafana",
        "external_url": "https://grafana.internal.example.invalid"
      },
      "tracing": {
        "enabled": true,
        "provider": "tempo",
        "internal_url": "http://cloudlab-tempo:3200",
        "use_grpc": false
      }
    },
    "istio_namespace": "istio-system"
  }
}
