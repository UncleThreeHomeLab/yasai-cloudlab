{
  "apiVersion": "monitoring.coreos.com/v1",
  "kind": "PrometheusRule",
  "metadata": {
    "name": "identity-evidence",
    "namespace": "cloudlab-observability"
  },
  "spec": {
    "groups": [
      {
        "name": "identity-evidence",
        "interval": "30s",
        "rules": [
          {
            "alert": "KeycloakLoginFailures",
            "expr": "sum by (realm) (increase(cloudlab_keycloak_login_failures_total[10m])) >= 10",
            "for": "1m",
            "labels": {
              "severity": "warning",
              "service": "keycloak"
            },
            "annotations": {
              "summary": "Repeated realm login failures",
              "description": "Inspect redacted realm events. Do not export credentials or user identifiers."
            }
          },
          {
            "alert": "KeycloakAdminChange",
            "expr": "sum by (realm) (increase(cloudlab_keycloak_admin_events_total[5m])) > 0",
            "for": "0s",
            "labels": {
              "severity": "warning",
              "service": "keycloak"
            },
            "annotations": {
              "summary": "Realm administrative change observed",
              "description": "Review intended configuration or maintenance against redacted operation events."
            }
          },
          {
            "alert": "KeycloakAuditIncomplete",
            "expr": "cloudlab_keycloak_audit_incomplete > 0",
            "for": "0s",
            "labels": {
              "severity": "warning",
              "service": "keycloak"
            },
            "annotations": {
              "summary": "Realm audit batch may be truncated",
              "description": "Latest 100 events cannot establish a complete audit. Reduce event volume or qualify a bounded event listener."
            }
          },
          {
            "alert": "KeycloakHealthJobFailed",
            "expr": "kube_job_status_failed{namespace=\"cloudlab-identity\",job_name=~\"identity-health-.*\"} > 0",
            "for": "1m",
            "labels": {
              "severity": "warning",
              "service": "keycloak"
            },
            "annotations": {
              "summary": "Realm health or audit job failed",
              "description": "Inspect private job status. Missing evidence is never healthy."
            }
          },
          {
            "alert": "KeycloakEvidenceStalePlatform",
            "expr": "(time() - cloudlab_keycloak_health_last_success_seconds{realm=\"platform\"} > 900) or absent(cloudlab_keycloak_health_last_success_seconds{realm=\"platform\"})",
            "for": "5m",
            "labels": {
              "severity": "warning",
              "service": "keycloak"
            },
            "annotations": {
              "summary": "Realm health evidence stale: platform",
              "description": "Check scheduled health job and Alloy. No complete poll observed within 15 minutes."
            }
          },
          {
            "alert": "KeycloakEvidenceStaleApplications",
            "expr": "(time() - cloudlab_keycloak_health_last_success_seconds{realm=\"applications\"} > 900) or absent(cloudlab_keycloak_health_last_success_seconds{realm=\"applications\"})",
            "for": "5m",
            "labels": {
              "severity": "warning",
              "service": "keycloak"
            },
            "annotations": {
              "summary": "Realm health evidence stale: applications",
              "description": "Check scheduled health job and Alloy. No complete poll observed within 15 minutes."
            }
          }
        ]
      }
    ]
  }
}
