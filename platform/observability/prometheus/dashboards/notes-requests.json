{
  "uid": "cloudlab-notes",
  "title": "Notes Requests",
  "description": "Operational traffic view; not SLO compliance. Select user, synthetic or release traffic. Zero requests means idle only with healthy scrapes. Missing evidence is UNKNOWN. Logs are redacted and retained 72h; traces 24h. Logs omit traffic classification and therefore are not filtered by traffic.",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "tags": [
    "cloudlab"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "metrics"
        },
        "query": "label_values(cloudlab_http_requests_total, service)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "sort": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "route",
        "label": "Route",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "metrics"
        },
        "query": "label_values(cloudlab_http_requests_total{service=~\"$service\"}, route)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "sort": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "traffic",
        "label": "Traffic",
        "type": "custom",
        "query": "user,synthetic,release",
        "current": {
          "text": "user",
          "value": "user"
        },
        "options": [
          {
            "text": "user",
            "value": "user",
            "selected": true
          },
          {
            "text": "synthetic",
            "value": "synthetic",
            "selected": false
          },
          {
            "text": "release",
            "value": "release",
            "selected": false
          }
        ]
      }
    ]
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "cloudlab"
      ],
      "title": "CloudLab dashboards",
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "Notes scrape health",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "UNKNOWN",
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "UNKNOWN",
                  "color": "gray"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "nan",
                "result": {
                  "text": "UNKNOWN",
                  "color": "gray"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{namespace=\"cloudlab-app-notes\",job=~\"notes-api|notes-web\"}",
          "legendFormat": "{{job}} / {{pod}}",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "colorMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      },
      "description": "Scrapes cover all Notes services, independent of traffic selection."
    },
    {
      "id": 2,
      "title": "Requests in selected range",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "metrics"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "UNKNOWN",
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "UNKNOWN",
                  "color": "gray"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "nan",
                "result": {
                  "text": "UNKNOWN",
                  "color": "gray"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(service,route) (increase(cloudlab_http_requests_total{service=~\"$service\",route=~\"$route\",traffic=\"$traffic\"}[$__range]))",
          "legendFormat": "{{service}} {{route}}",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "colorMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      },
      "description": "Zero is idle when scrapes are healthy. No series is UNKNOWN; an unobserved route or traffic class has no counter yet."
    },
    {
      "id": 3,
      "title": "Request rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "UNKNOWN",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(service,route) (rate(cloudlab_http_requests_total{service=~\"$service\",route=~\"$route\",traffic=\"$traffic\"}[$__rate_interval]))",
          "legendFormat": "{{service}} {{route}}",
          "range": true,
          "instant": false
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "title": "5xx fraction",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "metrics"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "UNKNOWN",
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum by(service,route) (rate(cloudlab_http_requests_total{service=~\"$service\",route=~\"$route\",traffic=\"$traffic\",status=~\"5..\"}[$__rate_interval])) or 0 * sum by(service,route) (rate(cloudlab_http_requests_total{service=~\"$service\",route=~\"$route\",traffic=\"$traffic\"}[$__rate_interval]))) / (sum by(service,route) (rate(cloudlab_http_requests_total{service=~\"$service\",route=~\"$route\",traffic=\"$traffic\"}[$__rate_interval])) > 0)",
          "legendFormat": "{{service}} {{route}}",
          "range": true,
          "instant": false
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "No fraction exists without requests; an idle interval is not 100% success."
    },
    {
      "id": 5,
      "title": "Responses by status",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "UNKNOWN",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(service,route,status) (rate(cloudlab_http_requests_total{service=~\"$service\",route=~\"$route\",traffic=\"$traffic\"}[$__rate_interval]))",
          "legendFormat": "{{service}} {{route}} {{status}}",
          "range": true,
          "instant": false
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "title": "Latency p50 / p95 / p99",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "metrics"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "UNKNOWN",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by(service,route,le) (rate(cloudlab_http_duration_seconds_bucket{service=~\"$service\",route=~\"$route\",traffic=\"$traffic\"}[$__rate_interval])))",
          "legendFormat": "{{service}} {{route}} p50",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by(service,route,le) (rate(cloudlab_http_duration_seconds_bucket{service=~\"$service\",route=~\"$route\",traffic=\"$traffic\"}[$__rate_interval])))",
          "legendFormat": "{{service}} {{route}} p95",
          "range": true
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by(service,route,le) (rate(cloudlab_http_duration_seconds_bucket{service=~\"$service\",route=~\"$route\",traffic=\"$traffic\"}[$__rate_interval])))",
          "legendFormat": "{{service}} {{route}} p99",
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "title": "Recent request logs (all traffic)",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "logs"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "UNKNOWN",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{kind=\"request\",service=~\"$service\"} | json | route=~\"$route\"",
          "queryType": "range",
          "maxLines": 100
        }
      ],
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "wrapLogMessage": true
      },
      "description": "Expand a log line and follow its TraceID derived field into Tempo. Traffic classification is not retained in logs."
    }
  ]
}
