{
  "uid": "cloudlab-workloads",
  "title": "Workloads",
  "description": "Namespace and pod troubleshooting. Empty issue tables require healthy kube-state-metrics evidence. Resource limits are absent for unlimited containers.",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "tags": [
    "cloudlab"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "metrics"
        },
        "query": "label_values(kube_pod_info, namespace)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "sort": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "pod",
        "label": "Pod",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "metrics"
        },
        "query": "label_values(kube_pod_info{namespace=~\"$namespace\"}, pod)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "sort": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "cloudlab"
      ],
      "title": "CloudLab dashboards",
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "Deployments: available / desired",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "UNKNOWN",
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kube_deployment_status_replicas_available{namespace=~\"$namespace\"} / kube_deployment_spec_replicas{namespace=~\"$namespace\"}",
          "legendFormat": "{{instance}}",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 2,
      "title": "StatefulSets: ready / desired",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "metrics"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "UNKNOWN",
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kube_statefulset_status_replicas_ready{namespace=~\"$namespace\"} / kube_statefulset_replicas{namespace=~\"$namespace\"}",
          "legendFormat": "{{instance}}",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 3,
      "title": "DaemonSets: ready / desired",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "UNKNOWN",
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kube_daemonset_status_number_ready{namespace=~\"$namespace\"} / kube_daemonset_status_desired_number_scheduled{namespace=~\"$namespace\"}",
          "legendFormat": "{{instance}}",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 4,
      "title": "Pod placement",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "metrics"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "UNKNOWN",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kube_pod_info{namespace=~\"$namespace\",pod=~\"$pod\"}",
          "legendFormat": "{{instance}}",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 5,
      "title": "Pending pods",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "UNKNOWN",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kube_pod_status_phase{namespace=~\"$namespace\",pod=~\"$pod\",phase=\"Pending\"} == 1",
          "legendFormat": "{{instance}}",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 6,
      "title": "Unschedulable pods",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "metrics"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "UNKNOWN",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kube_pod_status_unschedulable{namespace=~\"$namespace\",pod=~\"$pod\"} == 1",
          "legendFormat": "{{instance}}",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 7,
      "title": "Restarts (1h)",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "UNKNOWN",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(namespace,pod,container) (increase(kube_pod_container_status_restarts_total{namespace=~\"$namespace\",pod=~\"$pod\"}[1h])) > 0",
          "legendFormat": "{{instance}}",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 8,
      "title": "Last termination was OOMKilled",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "metrics"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "UNKNOWN",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kube_pod_container_status_last_terminated_reason{namespace=~\"$namespace\",pod=~\"$pod\",reason=\"OOMKilled\"} == 1",
          "legendFormat": "{{instance}}",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 9,
      "title": "Container waiting reasons",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "UNKNOWN",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kube_pod_container_status_waiting_reason{namespace=~\"$namespace\",pod=~\"$pod\"} == 1",
          "legendFormat": "{{instance}}",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 10,
      "title": "CPU cores used",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "metrics"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cores",
          "noValue": "UNKNOWN",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(namespace,pod,container) (rate(container_cpu_usage_seconds_total{namespace=~\"$namespace\",pod=~\"$pod\",container!=\"\",container!=\"POD\",image!=\"\"}[$__rate_interval]))",
          "legendFormat": "{{namespace}} / {{pod}} / {{container}}",
          "range": true,
          "instant": false
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 11,
      "title": "CPU throttled periods",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "UNKNOWN",
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(namespace,pod,container) (rate(container_cpu_cfs_throttled_periods_total{namespace=~\"$namespace\",pod=~\"$pod\",container!=\"\",container!=\"POD\",image!=\"\"}[$__rate_interval])) / sum by(namespace,pod,container) (rate(container_cpu_cfs_periods_total{namespace=~\"$namespace\",pod=~\"$pod\",container!=\"\",container!=\"POD\",image!=\"\"}[$__rate_interval]))",
          "legendFormat": "{{pod}} / {{container}}",
          "range": true,
          "instant": false
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 12,
      "title": "Memory working set",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "metrics"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "UNKNOWN",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(namespace,pod,container) (container_memory_working_set_bytes{namespace=~\"$namespace\",pod=~\"$pod\",container!=\"\",container!=\"POD\",image!=\"\"})",
          "legendFormat": "{{pod}} / {{container}}",
          "range": true,
          "instant": false
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 13,
      "title": "Memory / container limit",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "UNKNOWN",
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(namespace,pod,container) (container_memory_working_set_bytes{namespace=~\"$namespace\",pod=~\"$pod\",container!=\"\",container!=\"POD\",image!=\"\"}) / on(namespace,pod,container) (kube_pod_container_resource_limits{namespace=~\"$namespace\",pod=~\"$pod\",resource=\"memory\"} > 0)",
          "legendFormat": "{{pod}} / {{container}}",
          "range": true,
          "instant": false
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 14,
      "title": "PVC usage",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "metrics"
      },
      "gridPos": {
        "x": 12,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "UNKNOWN",
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kubelet_volume_stats_used_bytes{namespace=~\"$namespace\"} / kubelet_volume_stats_capacity_bytes",
          "legendFormat": "{{namespace}} / {{persistentvolumeclaim}}",
          "range": true,
          "instant": false
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ]
}
