{
  "uid": "cloudlab-overview",
  "title": "Lab Overview",
  "description": "Two-node lab. Empty issue tables mean no matching issues only when scrape evidence is healthy. Missing telemetry is UNKNOWN. Notes panels cover user reads.",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "tags": [
    "cloudlab"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "cloudlab"
      ],
      "title": "CloudLab dashboards",
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "Ready nodes (expected 2)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "UNKNOWN",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 2
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "UNKNOWN",
                  "color": "gray"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "nan",
                "result": {
                  "text": "UNKNOWN",
                  "color": "gray"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kube_node_status_condition{condition=\"Ready\",status=\"true\"})",
          "legendFormat": "{{instance}}",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "colorMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      }
    },
    {
      "id": 2,
      "title": "Scrape targets healthy",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "metrics"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "UNKNOWN",
          "color": {
            "mode": "thresholds"
          },
          "min": 0,
          "max": 1,
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "UNKNOWN",
                  "color": "gray"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "nan",
                "result": {
                  "text": "UNKNOWN",
                  "color": "gray"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up == bool 1) / count(up)",
          "legendFormat": "{{instance}}",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "colorMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      }
    },
    {
      "id": 3,
      "title": "CPU usage by node",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "UNKNOWN",
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[$__rate_interval]))",
          "legendFormat": "{{instance}}",
          "range": true,
          "instant": false
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "title": "Memory usage by node",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "metrics"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "UNKNOWN",
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes",
          "legendFormat": "{{instance}}",
          "range": true,
          "instant": false
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "title": "Filesystem space available",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "UNKNOWN",
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay|squashfs\",mountpoint!~\"/run.*\"} / node_filesystem_size_bytes",
          "legendFormat": "{{instance}} {{mountpoint}}",
          "range": true,
          "instant": false
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "title": "PVC usage",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "metrics"
      },
      "gridPos": {
        "x": 12,
        "y": 11,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "UNKNOWN",
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kubelet_volume_stats_used_bytes / kubelet_volume_stats_capacity_bytes",
          "legendFormat": "{{namespace}} / {{persistentvolumeclaim}}",
          "range": true,
          "instant": false
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "title": "Unavailable workload replicas",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "UNKNOWN",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(kube_deployment_spec_replicas - kube_deployment_status_replicas_available > 0) or (kube_statefulset_replicas - kube_statefulset_status_replicas_ready > 0) or (kube_daemonset_status_desired_number_scheduled - kube_daemonset_status_number_ready > 0)",
          "legendFormat": "{{instance}}",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 8,
      "title": "Pending pods",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "metrics"
      },
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "UNKNOWN",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kube_pod_status_phase{phase=\"Pending\"} == 1",
          "legendFormat": "{{instance}}",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 9,
      "title": "Container restarts (1h)",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "UNKNOWN",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (namespace,pod,container) (increase(kube_pod_container_status_restarts_total[1h])) > 0",
          "legendFormat": "{{instance}}",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 10,
      "title": "Firing alerts",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "metrics"
      },
      "gridPos": {
        "x": 12,
        "y": 25,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "UNKNOWN",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ALERTS{alertstate=\"firing\"} == 1",
          "legendFormat": "{{instance}}",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 11,
      "title": "Failed or stale scrapes",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "UNKNOWN",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(up == 0) or (time() - timestamp(up) > 90)",
          "legendFormat": "{{instance}}",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 12,
      "title": "Notes user read rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "metrics"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "UNKNOWN",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(cloudlab_http_requests_total{service=\"notes-api\",route=\"/api/notes\",traffic=\"user\"}[$__rate_interval]))",
          "legendFormat": "User reads",
          "range": true,
          "instant": false
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 13,
      "title": "Notes user 5xx fraction",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 39,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "UNKNOWN",
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(cloudlab_http_requests_total{service=\"notes-api\",route=\"/api/notes\",traffic=\"user\",status=~\"5..\"}[$__rate_interval])) or 0 * sum(rate(cloudlab_http_requests_total{service=\"notes-api\",route=\"/api/notes\",traffic=\"user\"}[$__rate_interval]))) / (sum(rate(cloudlab_http_requests_total{service=\"notes-api\",route=\"/api/notes\",traffic=\"user\"}[$__rate_interval])) > 0)",
          "legendFormat": "5xx fraction",
          "range": true,
          "instant": false
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 14,
      "title": "Notes user p95 latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "metrics"
      },
      "gridPos": {
        "x": 12,
        "y": 39,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "UNKNOWN",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(cloudlab_http_duration_seconds_bucket{service=\"notes-api\",route=\"/api/notes\",traffic=\"user\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "range": true,
          "instant": false
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ]
}
