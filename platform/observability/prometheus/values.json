{
  "kube-prometheus-stack": {
    "fullnameOverride": "cloudlab",
    "cleanPrometheusOperatorObjectNames": true,
    "crds": {
      "annotations": {
        "argocd.argoproj.io/sync-options": "ServerSideApply=true,Prune=false,Delete=false"
      }
    },
    "kubeControllerManager": {
      "enabled": false
    },
    "kubeScheduler": {
      "enabled": false
    },
    "kubeEtcd": {
      "enabled": false
    },
    "kubeProxy": {
      "enabled": false
    },
    "coreDns": {
      "enabled": false,
      "serviceMonitor": {
        "authorization": null
      }
    },
    "kubelet": {
      "serviceMonitor": {
        "authorization": null,
        "labelValueLengthLimit": 512,
        "metricRelabelings": [
          {
            "sourceLabels": [
              "__name__"
            ],
            "regex": "apiserver_.*",
            "action": "drop"
          }
        ],
        "bearerTokenFile": "/var/run/secrets/kubernetes.io/serviceaccount/token",
        "tlsConfig": {
          "insecureSkipVerify": false
        }
      }
    },
    "kubeApiServer": {
      "serviceMonitor": {
        "authorization": null,
        "sampleLimit": 100000,
        "bearerTokenFile": "/var/run/secrets/kubernetes.io/serviceaccount/token"
      }
    },
    "prometheusOperator": {
      "fullnameOverride": "cloudlab-prometheus-operator",
      "tls": {
        "enabled": false
      },
      "admissionWebhooks": {
        "enabled": false
      },
      "image": {
        "registry": "quay.io",
        "repository": "prometheus-operator/prometheus-operator",
        "tag": "v0.94.1",
        "sha": "7c88d4e7bae63bd8d0f8da986054337c23b4472fa8d3c6817f5bc4b8407a2d6a"
      },
      "resources": {
        "requests": {
          "cpu": "20m",
          "memory": "64Mi"
        },
        "limits": {
          "cpu": "150m",
          "memory": "256Mi"
        }
      },
      "namespaces": {
        "releaseNamespace": true,
        "additional": [
          "cloudlab-app-notes"
        ]
      },
      "prometheusInstanceNamespaces": [
        "cloudlab-observability"
      ],
      "alertmanagerInstanceNamespaces": [
        "cloudlab-observability"
      ],
      "alertmanagerConfigNamespaces": [
        "cloudlab-observability"
      ],
      "prometheusConfigReloader": {
        "image": {
          "registry": "quay.io",
          "repository": "prometheus-operator/prometheus-config-reloader",
          "tag": "v0.94.1",
          "sha": "06b52bd4dbe3ed6dd5905aadaf8b9987d9da4c31d37bb86deaadae68cee2d26b"
        },
        "resources": {
          "requests": {
            "cpu": "5m",
            "memory": "16Mi"
          },
          "limits": {
            "cpu": "25m",
            "memory": "48Mi"
          }
        }
      }
    },
    "prometheus": {
      "serviceAccount": {
        "name": "cloudlab-prometheus",
        "createTokenSecret": false
      },
      "serviceMonitor": {
        "labelValueLengthLimit": 512
      },
      "prometheusSpec": {
        "image": {
          "registry": "quay.io",
          "repository": "prometheus/prometheus",
          "tag": "v3.15.0-distroless",
          "sha": "b2a413d5a03ea6a76782a508d1c7947440bba3b973931a25676e278431891b01"
        },
        "retention": "7d",
        "retentionSize": "25GB",
        "replicas": 1,
        "resources": {
          "requests": {
            "cpu": "150m",
            "memory": "512Mi"
          },
          "limits": {
            "cpu": "800m",
            "memory": "2048Mi"
          }
        },
        "storageSpec": {
          "volumeClaimTemplate": {
            "spec": {
              "storageClassName": "cloudlab-telemetry",
              "accessModes": [
                "ReadWriteOnce"
              ],
              "resources": {
                "requests": {
                  "storage": "30Gi"
                }
              }
            }
          }
        },
        "serviceMonitorSelectorNilUsesHelmValues": false,
        "podMonitorSelectorNilUsesHelmValues": false,
        "ruleSelectorNilUsesHelmValues": false,
        "scrapeInterval": "30s",
        "evaluationInterval": "30s",
        "sampleLimit": 50000,
        "labelLimit": 40,
        "labelNameLengthLimit": 100,
        "labelValueLengthLimit": 200,
        "enableAdminAPI": false,
        "enableRemoteWriteReceiver": false
      }
    },
    "alertmanager": {
      "alertmanagerSpec": {
        "image": {
          "registry": "quay.io",
          "repository": "prometheus/alertmanager",
          "tag": "v0.34.1",
          "sha": "e9733bafb1bdef9b00e25a21f8f99dc26a22224bf16641ad754d1649f4c3357a"
        },
        "replicas": 1,
        "resources": {
          "requests": {
            "cpu": "20m",
            "memory": "64Mi"
          },
          "limits": {
            "cpu": "100m",
            "memory": "128Mi"
          }
        },
        "storage": {
          "emptyDir": {
            "sizeLimit": "64Mi"
          }
        }
      },
      "config": {
        "global": {
          "resolve_timeout": "1m"
        },
        "route": {
          "receiver": "private",
          "routes": [],
          "group_by": [
            "alertname",
            "service",
            "severity"
          ],
          "group_wait": "10s",
          "group_interval": "1m",
          "repeat_interval": "4h"
        },
        "receivers": [
          {
            "name": "private"
          }
        ]
      }
    },
    "grafana": {
      "fullnameOverride": "cloudlab-grafana",
      "image": {
        "registry": "docker.io",
        "repository": "grafana/grafana",
        "tag": "13.2.4",
        "sha": "dbbc38ea21103cefb50396340cd88afec779c7e070b0a7bf5a75b4ce46651d3f"
      },
      "deploymentStrategy": {
        "type": "Recreate"
      },
      "serviceAccount": {
        "automountServiceAccountToken": false
      },
      "automountServiceAccountToken": false,
      "admin": {
        "existingSecret": "grafana-emergency",
        "userKey": "username",
        "passwordKey": "password"
      },
      "resources": {
        "requests": {
          "cpu": "20m",
          "memory": "512Mi"
        },
        "limits": {
          "cpu": "250m",
          "memory": "768Mi"
        }
      },
      "initChownData": {
        "enabled": false
      },
      "testFramework": {
        "enabled": false
      },
      "sidecar": {
        "dashboards": {
          "enabled": false
        },
        "datasources": {
          "enabled": false
        }
      },
      "defaultDashboardsEnabled": false,
      "persistence": {
        "enabled": true,
        "storageClassName": "cloudlab-telemetry",
        "size": "5Gi"
      },
      "extraSecretMounts": [
        {
          "name": "grafana-oidc",
          "secretName": "grafana-oidc",
          "mountPath": "/etc/secrets/grafana-oidc",
          "readOnly": true
        },
        {
          "name": "grafana-emergency",
          "secretName": "grafana-emergency",
          "mountPath": "/etc/secrets/grafana-emergency",
          "readOnly": true
        }
      ],
      "grafana.ini": {
        "server": {
          "root_url": "https://grafana.internal.example.invalid"
        },
        "security": {
          "cookie_secure": true,
          "cookie_samesite": "lax",
          "disable_gravatar": true,
          "secret_key": "$__file{/etc/secrets/grafana-emergency/secret_key}"
        },
        "users": {
          "allow_sign_up": false
        },
        "analytics": {
          "reporting_enabled": false,
          "check_for_updates": false,
          "check_for_plugin_updates": false
        },
        "plugins": {
          "preinstall_disabled": true,
          "preinstall": "",
          "preinstall_sync": "",
          "public_key_retrieval_disabled": true,
          "plugin_admin_enabled": false
        },
        "auth": {
          "disable_login_form": false,
          "oauth_allow_insecure_email_lookup": false,
          "login_maximum_lifetime_duration": "5m",
          "login_maximum_inactive_lifetime_duration": "5m",
          "token_rotation_interval_minutes": 1,
          "signout_redirect_url": "https://login.example.invalid/realms/platform/protocol/openid-connect/logout?post_logout_redirect_uri=https%3A%2F%2Fgrafana.internal.example.invalid%2Flogin"
        },
        "auth.anonymous": {
          "enabled": false
        },
        "auth.generic_oauth": {
          "enabled": true,
          "name": "Keycloak",
          "client_id": "grafana",
          "client_secret": "$__file{/etc/secrets/grafana-oidc/client_secret}",
          "auth_url": "https://login.example.invalid/realms/platform/protocol/openid-connect/auth",
          "token_url": "https://login.example.invalid/realms/platform/protocol/openid-connect/token",
          "api_url": "https://login.example.invalid/realms/platform/protocol/openid-connect/userinfo",
          "scopes": "openid profile email",
          "use_pkce": true,
          "use_refresh_token": true,
          "allow_sign_up": true,
          "auto_login": false,
          "login_attribute_path": "sub",
          "role_attribute_path": "contains(groups[*], '/platform-admin') && 'Admin' || contains(groups[*], '/developer') && 'Editor' || contains(groups[*], '/viewer') && 'Viewer' || ''",
          "role_attribute_strict": true,
          "allow_assign_grafana_admin": false,
          "skip_org_role_sync": false
        },
        "unified_alerting": {
          "enabled": false
        },
        "alerting": {
          "enabled": false
        },
        "dashboards": {
          "default_home_dashboard_path": "/var/lib/grafana/dashboards/cloudlab/lab-overview.json"
        }
      },
      "datasources": {
        "datasources.yaml": {
          "apiVersion": 1,
          "prune": true,
          "datasources": [
            {
              "uid": "metrics",
              "name": "Prometheus",
              "type": "prometheus",
              "access": "proxy",
              "url": "http://cloudlab-prometheus:9090",
              "isDefault": true,
              "editable": false
            },
            {
              "uid": "logs",
              "name": "Loki",
              "type": "loki",
              "access": "proxy",
              "url": "http://cloudlab-loki:3100",
              "editable": false,
              "jsonData": {
                "derivedFields": [
                  {
                    "name": "TraceID",
                    "matcherRegex": "\"trace_id\":\"([a-f0-9]{32})\"",
                    "datasourceUid": "traces",
                    "url": "$${__value.raw}"
                  }
                ]
              }
            },
            {
              "uid": "traces",
              "name": "Tempo",
              "type": "tempo",
              "access": "proxy",
              "url": "http://cloudlab-tempo:3200",
              "editable": false,
              "jsonData": {
                "tracesToLogsV2": {
                  "datasourceUid": "logs",
                  "filterByTraceID": true
                },
                "nodeGraph": {
                  "enabled": true
                }
              }
            }
          ]
        }
      },
      "dashboardProviders": {
        "providers.yaml": {
          "apiVersion": 1,
          "providers": [
            {
              "name": "cloudlab",
              "orgId": 1,
              "folder": "CloudLab",
              "type": "file",
              "disableDeletion": false,
              "allowUiUpdates": false,
              "options": {
                "path": "/var/lib/grafana/dashboards/cloudlab"
              }
            }
          ]
        }
      },
      "dashboardsConfigMaps": {
        "cloudlab": "cloudlab-dashboards"
      }
    },
    "kube-state-metrics": {
      "image": {
        "registry": "registry.k8s.io",
        "repository": "kube-state-metrics/kube-state-metrics",
        "tag": "v2.20.0",
        "sha": "sha256:42cfe3723a5f058171c627537fb57a3ea0f26e4380fa18555a95cb1a1b4cfc5b"
      },
      "resources": {
        "requests": {
          "cpu": "20m",
          "memory": "64Mi"
        },
        "limits": {
          "cpu": "75m",
          "memory": "128Mi"
        }
      }
    },
    "prometheus-node-exporter": {
      "image": {
        "registry": "quay.io",
        "repository": "prometheus/node-exporter",
        "tag": "v1.12.1",
        "digest": "sha256:1b4e4438faca4dd7e001dd445d161a4a2091b0fededa84093b3a8dfeae1f1be0",
        "distroless": false
      },
      "resources": {
        "requests": {
          "cpu": "10m",
          "memory": "32Mi"
        },
        "limits": {
          "cpu": "50m",
          "memory": "64Mi"
        }
      }
    }
  }
}
