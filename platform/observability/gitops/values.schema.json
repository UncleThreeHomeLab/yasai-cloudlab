{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "nativeSource",
    "catalog",
    "observabilityInputs"
  ],
  "properties": {
    "nativeSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "revision",
        "valuesRepository"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^https://github[.]com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+[.]git$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "valuesRepository": {
          "type": "string",
          "pattern": "^https://github[.]com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+[.]git$"
        }
      }
    },
    "repository": {
      "type": "string",
      "pattern": "^https://github[.]com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+[.]git$"
    },
    "revision": {
      "type": "string"
    },
    "catalog": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "approval",
          "definition",
          "publication"
        ],
        "properties": {
          "approval": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "name",
              "namespace"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,30}$"
              },
              "namespace": {
                "type": "string",
                "pattern": "^cloudlab-app-[a-z][a-z0-9-]{0,30}$"
              }
            }
          },
          "definition": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,30}$"
              },
              "ports": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]{0,40}$"
                    },
                    "port": {
                      "type": "integer",
                      "minimum": 1024,
                      "maximum": 65535
                    }
                  },
                  "required": [
                    "name",
                    "port"
                  ]
                },
                "minItems": 1,
                "maxItems": 8,
                "uniqueItems": true
              },
              "monitoring": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "enabled"
                ],
                "properties": {
                  "enabled": {
                    "type": "boolean"
                  },
                  "routes": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 8,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "maxLength": 96,
                      "pattern": "^/([A-Za-z0-9_-]+|:[a-z][a-z0-9_]*)(/([A-Za-z0-9_-]+|:[a-z][a-z0-9_]*))*$|^/$"
                    }
                  },
                  "metrics": {
                    "oneOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "enabled"
                        ],
                        "properties": {
                          "enabled": {
                            "const": false
                          }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "enabled",
                          "profile",
                          "endpoints"
                        ],
                        "properties": {
                          "enabled": {
                            "const": true
                          },
                          "profile": {
                            "const": "cloudlab-http"
                          },
                          "endpoints": {
                            "type": "array",
                            "minItems": 1,
                            "maxItems": 1,
                            "items": {
                              "type": "object",
                              "additionalProperties": false,
                              "required": [
                                "port",
                                "path"
                              ],
                              "properties": {
                                "port": {
                                  "const": "http-metrics"
                                },
                                "path": {
                                  "const": "/metrics"
                                }
                              }
                            }
                          }
                        }
                      }
                    ]
                  },
                  "logs": {
                    "oneOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "enabled"
                        ],
                        "properties": {
                          "enabled": {
                            "const": false
                          }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "enabled",
                          "profile"
                        ],
                        "properties": {
                          "enabled": {
                            "const": true
                          },
                          "profile": {
                            "const": "cloudlab-http-json-v1"
                          }
                        }
                      }
                    ]
                  },
                  "traces": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "enabled"
                    ],
                    "properties": {
                      "enabled": {
                        "type": "boolean",
                        "description": "Generic service traces require qualified ambient workload attribution; metrics and logs are supported."
                      }
                    }
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "enabled": {
                          "const": true
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "routes"
                      ],
                      "anyOf": [
                        {
                          "required": [
                            "metrics"
                          ],
                          "properties": {
                            "metrics": {
                              "properties": {
                                "enabled": {
                                  "const": true
                                }
                              }
                            }
                          }
                        },
                        {
                          "required": [
                            "logs"
                          ],
                          "properties": {
                            "logs": {
                              "properties": {
                                "enabled": {
                                  "const": true
                                }
                              }
                            }
                          }
                        }
                      ]
                    },
                    "else": {
                      "properties": {
                        "metrics": {
                          "properties": {
                            "enabled": {
                              "const": false
                            }
                          }
                        },
                        "logs": {
                          "properties": {
                            "enabled": {
                              "const": false
                            }
                          }
                        }
                      }
                    }
                  }
                ]
              },
              "health": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "readiness": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "path": {
                        "type": "string",
                        "pattern": "^/[A-Za-z0-9/_-]*$"
                      },
                      "port": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9-]{0,40}$"
                      }
                    },
                    "required": [
                      "path",
                      "port"
                    ]
                  },
                  "liveness": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "path": {
                        "type": "string",
                        "pattern": "^/[A-Za-z0-9/_-]*$"
                      },
                      "port": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9-]{0,40}$"
                      }
                    },
                    "required": [
                      "path",
                      "port"
                    ]
                  }
                },
                "required": [
                  "readiness",
                  "liveness"
                ]
              },
              "exposure": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "class": {
                        "const": "none"
                      }
                    },
                    "required": [
                      "class"
                    ]
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "class": {
                        "enum": [
                          "public",
                          "private"
                        ]
                      },
                      "hostname": {
                        "type": "string",
                        "pattern": "^[a-z0-9.-]+$"
                      },
                      "access": {
                        "enum": [
                          "public",
                          "human",
                          "machine",
                          "tailnet"
                        ]
                      },
                      "path": {
                        "type": "string",
                        "pattern": "^/[A-Za-z0-9/_-]*$"
                      },
                      "port": {
                        "type": "integer",
                        "minimum": 1024,
                        "maximum": 65535
                      }
                    },
                    "required": [
                      "class"
                    ],
                    "description": "Ordinary services declare the class signal only; addresses live in exposure inputs."
                  }
                ]
              },
              "additionalExposures": {
                "type": "array",
                "maxItems": 4,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "class": {
                      "const": "private"
                    },
                    "hostname": {
                      "type": "string",
                      "pattern": "^[a-z0-9.-]+$"
                    },
                    "access": {
                      "enum": [
                        "public",
                        "human",
                        "machine",
                        "tailnet"
                      ]
                    },
                    "path": {
                      "type": "string",
                      "pattern": "^/[A-Za-z0-9/_-]*$"
                    },
                    "port": {
                      "type": "integer",
                      "minimum": 1024,
                      "maximum": 65535
                    }
                  },
                  "required": [
                    "class",
                    "hostname",
                    "access",
                    "path",
                    "port"
                  ]
                },
                "uniqueItems": true
              },
              "rollouts": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "enabled": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "enabled"
                ]
              },
              "replicas": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3
              },
              "owner": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,40}$"
              }
            },
            "allOf": [
              {
                "if": {
                  "required": [
                    "monitoring"
                  ],
                  "properties": {
                    "monitoring": {
                      "required": [
                        "enabled"
                      ],
                      "properties": {
                        "enabled": {
                          "const": true
                        }
                      }
                    }
                  }
                },
                "then": {
                  "required": [
                    "ports",
                    "health",
                    "exposure",
                    "rollouts",
                    "replicas",
                    "owner"
                  ]
                }
              }
            ]
          },
          "publication": {
            "type": "string",
            "enum": [
              "ready",
              "published",
              "retired"
            ]
          }
        }
      }
    },
    "observabilityInputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "loginHost",
        "grafanaHost",
        "kialiHost",
        "apiPeers",
        "monitoringEnabled"
      ],
      "properties": {
        "loginHost": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^login[.][a-z0-9]+([.-][a-z0-9]+)*$"
        },
        "grafanaHost": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^grafana[.]internal[.][a-z0-9]+([.-][a-z0-9]+)*$"
        },
        "kialiHost": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^kiali[.]internal[.][a-z0-9]+([.-][a-z0-9]+)*$"
        },
        "apiPeers": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 43,
            "anyOf": [
              {
                "pattern": "^(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])([.](25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}/32$"
              },
              {
                "pattern": "^(([0-9a-fA-F]{1,4}:){7}[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,7}:|([0-9a-fA-F]{1,4}:){1,6}:[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,5}(:[0-9a-fA-F]{1,4}){1,2}|([0-9a-fA-F]{1,4}:){1,4}(:[0-9a-fA-F]{1,4}){1,3}|([0-9a-fA-F]{1,4}:){1,3}(:[0-9a-fA-F]{1,4}){1,4}|([0-9a-fA-F]{1,4}:){1,2}(:[0-9a-fA-F]{1,4}){1,5}|[0-9a-fA-F]{1,4}:((:[0-9a-fA-F]{1,4}){1,6})|:((:[0-9a-fA-F]{1,4}){1,7}|:))/128$"
              }
            ]
          }
        },
        "monitoringEnabled": {
          "type": "boolean"
        }
      }
    },
    "platformNotifications": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "fallbackReceiver": {
          "type": "string",
          "maxLength": 31,
          "pattern": "^$|^[a-z][a-z0-9-]{0,30}$"
        },
        "receivers": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,30}$",
                "maxLength": 31
              },
              "email": {
                "type": "object",
                "additionalProperties": false,
                "description": "SMTP account and Alertmanager egress are owned elsewhere: the external account must already exist and delivery paths stay with the workload/network owners.",
                "properties": {
                  "host": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*$",
                    "maxLength": 253
                  },
                  "port": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                  },
                  "from": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9._%+-]+@[A-Za-z0-9]+([.-][A-Za-z0-9]+)*$",
                    "maxLength": 254
                  },
                  "to": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9._%+-]+@[A-Za-z0-9]+([.-][A-Za-z0-9]+)*$",
                    "maxLength": 254
                  },
                  "username": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9@._+-]+$",
                    "maxLength": 254
                  },
                  "passwordSecretRef": {
                    "$ref": "#/$defs/notificationSecret"
                  },
                  "caSecretRef": {
                    "$ref": "#/$defs/notificationSecret"
                  }
                },
                "required": [
                  "host",
                  "port",
                  "from",
                  "to"
                ],
                "allOf": [
                  {
                    "if": {
                      "required": [
                        "username"
                      ]
                    },
                    "then": {
                      "required": [
                        "passwordSecretRef"
                      ]
                    }
                  },
                  {
                    "if": {
                      "required": [
                        "passwordSecretRef"
                      ]
                    },
                    "then": {
                      "required": [
                        "username"
                      ]
                    }
                  }
                ]
              },
              "webhook": {
                "type": "object",
                "additionalProperties": false,
                "description": "Mesh mode uses ambient workload identity; method/path enforcement requires a supported waypoint or application enforcement qualified by the workload owner.",
                "properties": {
                  "target": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "service": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9-]{0,30}$",
                        "maxLength": 31
                      },
                      "port": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9-]{0,14}$",
                        "maxLength": 15
                      },
                      "path": {
                        "type": "string",
                        "pattern": "^/([A-Za-z0-9_-]+(/[A-Za-z0-9_-]+)*)?$",
                        "maxLength": 256
                      }
                    },
                    "required": [
                      "service",
                      "port",
                      "path"
                    ]
                  },
                  "authentication": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "mode": {
                        "enum": [
                          "bearer",
                          "mesh"
                        ]
                      },
                      "secretRef": {
                        "$ref": "#/$defs/notificationSecret"
                      }
                    },
                    "required": [
                      "mode"
                    ],
                    "allOf": [
                      {
                        "if": {
                          "properties": {
                            "mode": {
                              "const": "bearer"
                            }
                          }
                        },
                        "then": {
                          "required": [
                            "secretRef"
                          ]
                        },
                        "else": {
                          "not": {
                            "required": [
                              "secretRef"
                            ]
                          }
                        }
                      }
                    ]
                  },
                  "caSecretRef": {
                    "$ref": "#/$defs/notificationSecret"
                  }
                },
                "required": [
                  "target",
                  "authentication"
                ],
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "authentication": {
                          "properties": {
                            "mode": {
                              "const": "mesh"
                            }
                          }
                        }
                      }
                    },
                    "then": {
                      "not": {
                        "required": [
                          "caSecretRef"
                        ]
                      }
                    }
                  }
                ]
              }
            },
            "required": [
              "name"
            ],
            "oneOf": [
              {
                "required": [
                  "email"
                ]
              },
              {
                "required": [
                  "webhook"
                ]
              }
            ]
          }
        },
        "subscriptions": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "service": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,30}$",
                "maxLength": 31
              },
              "severities": {
                "type": "array",
                "minItems": 1,
                "maxItems": 3,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "info",
                    "warning",
                    "critical"
                  ]
                }
              },
              "receivers": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,30}$",
                  "maxLength": 31
                }
              }
            },
            "required": [
              "service",
              "severities",
              "receivers"
            ]
          }
        },
        "groupWaitSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60
        },
        "groupIntervalSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "repeatIntervalSeconds": {
          "type": "integer",
          "minimum": 30,
          "maximum": 86400
        },
        "timeIntervals": {
          "type": "array",
          "maxItems": 8,
          "description": "Recurring maintenance schedules rendered as native time intervals; incident silences stay authorized runtime operations, not Git state.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,30}$",
                "maxLength": 31
              },
              "weekdays": {
                "type": "array",
                "minItems": 1,
                "maxItems": 7,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "monday",
                    "tuesday",
                    "wednesday",
                    "thursday",
                    "friday",
                    "saturday",
                    "sunday"
                  ]
                }
              },
              "times": {
                "type": "array",
                "minItems": 1,
                "maxItems": 4,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "start": {
                      "type": "string",
                      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                    },
                    "end": {
                      "type": "string",
                      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                    }
                  },
                  "required": [
                    "start",
                    "end"
                  ]
                }
              },
              "months": {
                "type": "array",
                "minItems": 1,
                "maxItems": 12,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "january",
                    "february",
                    "march",
                    "april",
                    "may",
                    "june",
                    "july",
                    "august",
                    "september",
                    "october",
                    "november",
                    "december"
                  ]
                }
              },
              "daysOfMonth": {
                "type": "array",
                "minItems": 1,
                "maxItems": 31,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^(0?[1-9]|[12][0-9]|3[01])$",
                  "maxLength": 2
                }
              }
            },
            "required": [
              "name",
              "weekdays",
              "times"
            ]
          }
        },
        "muteWindows": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "description": "Each entry must reference a declared time interval; applied at the root route so recurring maintenance mutes all child routes.",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,30}$",
            "maxLength": 31
          }
        },
        "inhibitRules": {
          "type": "array",
          "maxItems": 8,
          "description": "Bounded native inhibition with equality matchers only; fallback, continuation, and recovery delivery are preserved.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "sourceMatchers": {
                "type": "array",
                "minItems": 1,
                "maxItems": 6,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/equalityMatcher"
                }
              },
              "targetMatchers": {
                "type": "array",
                "minItems": 1,
                "maxItems": 6,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/equalityMatcher"
                }
              },
              "equal": {
                "type": "array",
                "maxItems": 6,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "alertname",
                    "service",
                    "severity",
                    "namespace"
                  ]
                }
              }
            },
            "required": [
              "sourceMatchers",
              "targetMatchers"
            ]
          }
        }
      },
      "required": [
        "enabled",
        "fallbackReceiver",
        "receivers",
        "subscriptions",
        "groupWaitSeconds",
        "groupIntervalSeconds",
        "repeatIntervalSeconds",
        "timeIntervals",
        "muteWindows",
        "inhibitRules"
      ]
    },
    "alertmanagerState": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "storageClass": {
          "const": "cloudlab-telemetry"
        },
        "sizeGiB": {
          "const": 1
        }
      },
      "required": [
        "storageClass",
        "sizeGiB"
      ]
    },
    "serviceObservability": {
      "type": "object",
      "maxProperties": 20,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]{0,30}$"
      },
      "additionalProperties": {
        "type": "object",
