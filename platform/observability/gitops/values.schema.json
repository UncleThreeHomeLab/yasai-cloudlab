{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "nativeSource",
    "catalog",
    "observabilityInputs"
  ],
  "properties": {
    "nativeSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "revision",
        "valuesRepository",
        "valuesRevision"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^https://github[.]com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+[.]git$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "valuesRepository": {
          "type": "string",
          "pattern": "^https://github[.]com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+[.]git$"
        },
        "valuesRevision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      }
    },
    "repository": {
      "type": "string",
      "pattern": "^https://github[.]com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+[.]git$"
    },
    "revision": {
      "type": "string"
    },
    "catalog": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "approval",
          "definition",
          "publication"
        ],
        "properties": {
          "approval": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "name",
              "namespace"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,30}$"
              },
              "namespace": {
                "type": "string",
                "pattern": "^cloudlab-app-[a-z][a-z0-9-]{0,30}$"
              }
            }
          },
          "definition": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,30}$"
              }
            }
          },
          "publication": {
            "type": "string",
            "enum": [
              "ready",
              "published",
              "retired"
            ]
          }
        }
      }
    },
    "observabilityInputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "loginHost",
        "grafanaHost",
        "kialiHost",
        "apiPeers",
        "monitoringEnabled"
      ],
      "properties": {
        "loginHost": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^login[.][a-z0-9]+([.-][a-z0-9]+)*$"
        },
        "grafanaHost": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^grafana[.]internal[.][a-z0-9]+([.-][a-z0-9]+)*$"
        },
        "kialiHost": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^kiali[.]internal[.][a-z0-9]+([.-][a-z0-9]+)*$"
        },
        "apiPeers": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 43,
            "anyOf": [
              {
                "pattern": "^(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])([.](25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}/32$"
              },
              {
                "pattern": "^(([0-9a-fA-F]{1,4}:){7}[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,7}:|([0-9a-fA-F]{1,4}:){1,6}:[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,5}(:[0-9a-fA-F]{1,4}){1,2}|([0-9a-fA-F]{1,4}:){1,4}(:[0-9a-fA-F]{1,4}){1,3}|([0-9a-fA-F]{1,4}:){1,3}(:[0-9a-fA-F]{1,4}){1,4}|([0-9a-fA-F]{1,4}:){1,2}(:[0-9a-fA-F]{1,4}){1,5}|[0-9a-fA-F]{1,4}:((:[0-9a-fA-F]{1,4}){1,6})|:((:[0-9a-fA-F]{1,4}){1,7}|:))/128$"
              }
            ]
          }
        },
        "monitoringEnabled": {
          "type": "boolean"
        }
      }
    }
  }
}
