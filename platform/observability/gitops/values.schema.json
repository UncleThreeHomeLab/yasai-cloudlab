{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "nativeSource",
    "catalog",
    "observabilityInputs"
  ],
  "properties": {
    "nativeSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "revision",
        "valuesRepository",
        "valuesRevision"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^https://github[.]com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+[.]git$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "valuesRepository": {
          "type": "string",
          "pattern": "^https://github[.]com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+[.]git$"
        },
        "valuesRevision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      }
    },
    "repository": {
      "type": "string",
      "pattern": "^https://github[.]com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+[.]git$"
    },
    "revision": {
      "type": "string"
    },
    "catalog": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "approval",
          "definition",
          "publication"
        ],
        "properties": {
          "approval": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "name",
              "namespace"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,30}$"
              },
              "namespace": {
                "type": "string",
                "pattern": "^cloudlab-app-[a-z][a-z0-9-]{0,30}$"
              }
            }
          },
          "definition": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,30}$"
              },
              "ports": {
                "type": "array",
                "maxItems": 16,
                "items": {
                  "type": "object",
                  "required": [
                    "name",
                    "port"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]{0,14}$",
                      "maxLength": 15
                    },
                    "port": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 65535
                    },
                    "protocol": {
                      "enum": [
                        "TCP",
                        "UDP"
                      ]
                    }
                  }
                }
              }
            }
          },
          "publication": {
            "type": "string",
            "enum": [
              "ready",
              "published",
              "retired"
            ]
          }
        }
      }
    },
    "observabilityInputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "loginHost",
        "grafanaHost",
        "kialiHost",
        "apiPeers",
        "monitoringEnabled"
      ],
      "properties": {
        "loginHost": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^login[.][a-z0-9]+([.-][a-z0-9]+)*$"
        },
        "grafanaHost": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^grafana[.]internal[.][a-z0-9]+([.-][a-z0-9]+)*$"
        },
        "kialiHost": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^kiali[.]internal[.][a-z0-9]+([.-][a-z0-9]+)*$"
        },
        "apiPeers": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 43,
            "anyOf": [
              {
                "pattern": "^(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])([.](25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}/32$"
              },
              {
                "pattern": "^(([0-9a-fA-F]{1,4}:){7}[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,7}:|([0-9a-fA-F]{1,4}:){1,6}:[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,5}(:[0-9a-fA-F]{1,4}){1,2}|([0-9a-fA-F]{1,4}:){1,4}(:[0-9a-fA-F]{1,4}){1,3}|([0-9a-fA-F]{1,4}:){1,3}(:[0-9a-fA-F]{1,4}){1,4}|([0-9a-fA-F]{1,4}:){1,2}(:[0-9a-fA-F]{1,4}){1,5}|[0-9a-fA-F]{1,4}:((:[0-9a-fA-F]{1,4}){1,6})|:((:[0-9a-fA-F]{1,4}){1,7}|:))/128$"
              }
            ]
          }
        },
        "monitoringEnabled": {
          "type": "boolean"
        }
      }
    },
    "platformNotifications": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "fallbackReceiver": {
          "type": "string",
          "maxLength": 31,
          "pattern": "^$|^[a-z][a-z0-9-]{0,30}$"
        },
        "receivers": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,30}$",
                "maxLength": 31
              },
              "email": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "host": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*$",
                    "maxLength": 253
                  },
                  "port": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                  },
                  "from": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9._%+-]+@[A-Za-z0-9]+([.-][A-Za-z0-9]+)*$",
                    "maxLength": 254
                  },
                  "to": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9._%+-]+@[A-Za-z0-9]+([.-][A-Za-z0-9]+)*$",
                    "maxLength": 254
                  },
                  "username": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9@._+-]+$",
                    "maxLength": 254
                  },
                  "passwordSecretRef": {
                    "$ref": "#/$defs/notificationSecret"
                  },
                  "caSecretRef": {
                    "$ref": "#/$defs/notificationSecret"
                  }
                },
                "required": [
                  "host",
                  "port",
                  "from",
                  "to"
                ],
                "allOf": [
                  {
                    "if": {
                      "required": [
                        "username"
                      ]
                    },
                    "then": {
                      "required": [
                        "passwordSecretRef"
                      ]
                    }
                  },
                  {
                    "if": {
                      "required": [
                        "passwordSecretRef"
                      ]
                    },
                    "then": {
                      "required": [
                        "username"
                      ]
                    }
                  }
                ]
              },
              "webhook": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "target": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "service": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9-]{0,30}$",
                        "maxLength": 31
                      },
                      "port": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9-]{0,14}$",
                        "maxLength": 15
                      },
                      "path": {
                        "type": "string",
                        "pattern": "^/([A-Za-z0-9_-]+(/[A-Za-z0-9_-]+)*)?$",
                        "maxLength": 256
                      }
                    },
                    "required": [
                      "service",
                      "port",
                      "path"
                    ]
                  },
                  "authentication": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "mode": {
                        "enum": [
                          "bearer",
                          "mesh"
                        ]
                      },
                      "secretRef": {
                        "$ref": "#/$defs/notificationSecret"
                      }
                    },
                    "required": [
                      "mode"
                    ],
                    "allOf": [
                      {
                        "if": {
                          "properties": {
                            "mode": {
                              "const": "bearer"
                            }
                          }
                        },
                        "then": {
                          "required": [
                            "secretRef"
                          ]
                        },
                        "else": {
                          "not": {
                            "required": [
                              "secretRef"
                            ]
                          }
                        }
                      }
                    ]
                  },
                  "caSecretRef": {
                    "$ref": "#/$defs/notificationSecret"
                  }
                },
                "required": [
                  "target",
                  "authentication"
                ],
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "authentication": {
                          "properties": {
                            "mode": {
                              "const": "mesh"
                            }
                          }
                        }
                      }
                    },
                    "then": {
                      "not": {
                        "required": [
                          "caSecretRef"
                        ]
                      }
                    }
                  }
                ]
              }
            },
            "required": [
              "name"
            ],
            "oneOf": [
              {
                "required": [
                  "email"
                ]
              },
              {
                "required": [
                  "webhook"
                ]
              }
            ]
          }
        },
        "subscriptions": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "service": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,30}$",
                "maxLength": 31
              },
              "severities": {
                "type": "array",
                "minItems": 1,
                "maxItems": 3,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "info",
                    "warning",
                    "critical"
                  ]
                }
              },
              "receivers": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,30}$",
                  "maxLength": 31
                }
              }
            },
            "required": [
              "service",
              "severities",
              "receivers"
            ]
          }
        },
        "groupWaitSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60
        },
        "groupIntervalSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "repeatIntervalSeconds": {
          "type": "integer",
          "minimum": 30,
          "maximum": 86400
        }
      },
      "required": [
        "enabled",
        "fallbackReceiver",
        "receivers",
        "subscriptions",
        "groupWaitSeconds",
        "groupIntervalSeconds",
        "repeatIntervalSeconds"
      ]
    },
    "alertmanagerState": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "storageClass": {
          "const": "cloudlab-telemetry"
        },
        "sizeGiB": {
          "const": 1
        }
      },
      "required": [
        "storageClass",
        "sizeGiB"
      ]
    }
  },
  "$defs": {
    "notificationSecret": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^alertmanager-notification-[a-z0-9]([a-z0-9-]*[a-z0-9])?$",
          "maxLength": 63
        },
        "key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,62}$",
          "maxLength": 63
        }
      },
      "required": [
        "name",
        "key"
      ]
    }
  }
}
