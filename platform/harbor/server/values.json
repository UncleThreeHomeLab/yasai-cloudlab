          "command": [
            "/bin/sh",
            "-ec",
            "umask 077; exec openssl rsa -traditional -in /source/tls.key -out /output/registry-private-key.pem"
          ],
          "securityContext": {
            "runAsNonRoot": true,
            "runAsUser": 10000,
            "allowPrivilegeEscalation": false,
            "readOnlyRootFilesystem": true,
            "capabilities": {
              "drop": [
                "ALL"
              ]
            },
            "seccompProfile": {
              "type": "RuntimeDefault"
            }
          },
          "resources": {
            "requests": {
              "cpu": "10m",
              "memory": "16Mi"
            },
            "limits": {
              "cpu": "100m",
              "memory": "64Mi"
            }
          },
          "volumeMounts": [
            {
              "name": "token-service-private-key",
              "mountPath": "/source",
              "readOnly": true
            },
            {
              "name": "psc",
              "mountPath": "/output"
            }
          ]
        }
      ]
