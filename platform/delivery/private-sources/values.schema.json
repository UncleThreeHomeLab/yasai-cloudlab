{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["sources"],
  "properties": {
    "sources": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "repository", "revision", "path"],
        "properties": {
          "name": {"type": "string", "pattern": "^([a-z][a-z0-9-]{0,28}[a-z0-9]|[a-z])$", "not": {"enum": ["sources", "sources-source"]}},
          "repository": {"type": "string", "pattern": "^https://github[.]com/[A-Za-z0-9][A-Za-z0-9-]*/[A-Za-z0-9][A-Za-z0-9_.-]*[.]git$"},
          "revision": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9/_.-]*$"},
          "path": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9/_.-]*$"}
        }
      }
    }
  }
}
