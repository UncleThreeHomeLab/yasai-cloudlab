{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repository",
    "revision",
    "catalog"
  ],
  "properties": {
    "repository": {
      "type": "string",
      "pattern": "^https://github[.]com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+[.]git$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "catalog": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "approval",
          "definition"
        ],
        "properties": {
          "approval": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "repository",
              "revision",
              "valuesPath",
              "namespace",
              "secretReferences",
              "configMaps"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,30}$"
              },
              "repository": {
                "type": "string",
                "pattern": "^https://github[.]com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+[.]git$"
              },
              "revision": {
                "type": "string",
                "pattern": "^[a-f0-9]{40}$"
              },
              "valuesPath": {
                "type": "string",
                "pattern": "^apps/[a-z0-9/-]+[.]yaml$"
              },
              "namespace": {
                "type": "string",
                "pattern": "^cloudlab-app-[a-z][a-z0-9-]{0,30}$"
              },
              "secretReferences": {
                "type": "array",
                "uniqueItems": true,
                "maxItems": 16,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,30}$"
                }
              },
              "configMaps": {
                "type": "array",
                "uniqueItems": true,
                "maxItems": 16,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,30}$"
                }
              },
              "visibility": {
                "enum": [
                  "public",
                  "private"
                ]
              },
              "chartPath": {
                "enum": [
                  "charts/service",
                  "apps/notes"
                ]
              },
              "artifact": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "repository",
                  "project",
                  "releasePath",
                  "sourceRepository",
                  "identities",
                  "action"
                ],
                "properties": {
                  "repository": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9.-]{0,252}/cloudlab-(public|private)/[a-z][a-z0-9-]{0,30}$"
                  },
                  "project": {
                    "enum": [
                      "cloudlab-public",
                      "cloudlab-private"
                    ]
                  },
                  "releasePath": {
                    "type": "string",
                    "pattern": "^apps/releases/[a-z][a-z0-9-]{0,30}[.]json$"
                  },
                  "sourceRepository": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9-]+/[A-Za-z0-9_.-]+$"
                  },
                  "identities": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 8,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "pattern": "^https://github[.]com/[A-Za-z0-9-]+/[A-Za-z0-9_.-]+/[.]github/workflows/(application-publish[.]yaml@[a-f0-9]{40}|ci[.]yaml@refs/heads/main)$"
                    }
                  },
                  "action": {
                    "enum": [
                      "Audit",
                      "Enforce"
                    ]
                  },
                  "components": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 12,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]{0,30}$"
                    }
                  },
                  "primaryComponent": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{0,30}$"
                  }
                }
              },
              "composition": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "chart",
                  "imageValues",
                  "images",
                  "workloads",
                  "claims",
                  "budget",
                  "backends",
                  "secrets"
                ],
                "properties": {
                  "chart": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "repository",
                      "revision",
                      "path"
                    ],
                    "properties": {
                      "repository": {
                        "type": "string",
                        "pattern": "^https://github[.]com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+[.]git$"
                      },
                      "revision": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{40}$"
                      },
                      "path": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9_-]+(/[A-Za-z0-9_-]+)*$"
                      }
                    }
                  },
                  "imageValues": {
                    "type": "object",
                    "minProperties": 1,
                    "maxProperties": 12,
                    "additionalProperties": {
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9]*([.][A-Za-z][A-Za-z0-9]*){0,7}$"
                    }
                  },
                  "images": {
                    "type": "object",
                    "minProperties": 1,
                    "maxProperties": 12,
                    "additionalProperties": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9./:_-]+@sha256:[a-f0-9]{64}$"
                    }
                  },
                  "workloads": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 12,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "name",
                        "replicas",
                        "podSpec"
                      ],
                      "properties": {
                        "name": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9-]{0,30}$"
                        },
                        "replicas": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 3
                        },
                        "podSpec": {
                          "type": "object"
                        },
                        "selector": {
                          "type": "object",
                          "minProperties": 1,
                          "maxProperties": 8,
                          "propertyNames": {
                            "pattern": "^[a-zA-Z0-9./_-]{1,100}$"
                          },
                          "additionalProperties": {
                            "type": "string",
                            "pattern": "^[a-zA-Z0-9._-]{1,63}$"
                          }
                        }
                      }
                    }
                  },
                  "claims": {
                    "type": "array",
                    "maxItems": 16,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "name",
                        "size"
                      ],
                      "properties": {
                        "name": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9-]{0,30}$"
                        },
                        "size": {
                          "type": "string",
                          "pattern": "^[1-9][0-9]?Gi$"
                        }
                      }
                    }
                  },
                  "budget": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "requests.cpu",
                      "requests.memory",
                      "limits.cpu",
                      "limits.memory",
                      "pods",
                      "persistentvolumeclaims",
                      "requests.storage"
                    ],
                    "properties": {
                      "requests.cpu": {
                        "type": "string",
                        "pattern": "^[1-9][0-9]{0,4}m$"
                      },
                      "limits.cpu": {
                        "type": "string",
                        "pattern": "^[1-9][0-9]{0,4}m$"
                      },
                      "requests.memory": {
                        "type": "string",
                        "pattern": "^[1-9][0-9]{0,5}Mi$"
                      },
                      "limits.memory": {
                        "type": "string",
                        "pattern": "^[1-9][0-9]{0,5}Mi$"
                      },
                      "pods": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 32
                      },
                      "persistentvolumeclaims": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 16
                      },
                      "requests.storage": {
                        "type": "string",
                        "pattern": "^[1-9][0-9]?Gi$"
                      }
                    }
                  },
                  "secrets": {
                    "type": "array",
                    "maxItems": 8,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "name",
                        "item",
                        "fields"
                      ],
                      "properties": {
                        "name": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9-]{0,30}$"
                        },
                        "item": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9-]{0,30}$"
                        },
                        "fields": {
                          "type": "object",
                          "minProperties": 1,
                          "maxProperties": 32,
                          "additionalProperties": {
                            "type": "string",
                            "pattern": "^[a-zA-Z0-9_-]{1,64}$"
                          }
                        }
                      }
                    }
                  },
                  "backends": {
                    "type": "object",
                    "minProperties": 0,
                    "maxProperties": 8,
                    "additionalProperties": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "service",
                        "port",
                        "selector"
                      ],
                      "properties": {
                        "service": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9-]{0,30}$"
                        },
                        "port": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 65535
                        },
                        "selector": {
                          "type": "object",
                          "minProperties": 1,
                          "maxProperties": 8,
                          "additionalProperties": {
                            "type": "string",
                            "pattern": "^[a-zA-Z0-9._-]{1,63}$"
                          }
                        },
                        "readiness": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "path",
                            "statuses"
                          ],
                          "properties": {
                            "path": {
                              "type": "string",
                              "pattern": "^/[a-zA-Z0-9/_-]{0,127}$"
                            },
                            "statuses": {
                              "type": "array",
                              "minItems": 1,
                              "maxItems": 6,
                              "uniqueItems": true,
                              "items": {
                                "enum": [
                                  200,
                                  204,
                                  400,
                                  401,
                                  403
                                ]
                              }
                            }
                          }
                        }
                      }
                    },
                    "propertyNames": {
                      "pattern": "^[a-z0-9][a-z0-9.-]{0,251}[a-z0-9]$"
                    }
                  },
                  "connections": {
                    "type": "array",
                    "maxItems": 144,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "source",
                        "destination",
                        "ports"
                      ],
                      "properties": {
                        "source": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9-]{0,30}$"
                        },
                        "destination": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9-]{0,30}$"
                        },
                        "ports": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 16,
                          "uniqueItems": true,
                          "items": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 65535
                          }
                        }
                      }
                    }
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "required": [
                        "connections"
                      ]
                    },
                    "then": {
                      "properties": {
                        "workloads": {
                          "items": {
                            "required": [
                              "selector"
                            ]
                          }
                        }
                      }
                    },
                    "else": {
                      "properties": {
                        "workloads": {
                          "items": {
                            "not": {
                              "required": [
                                "selector"
                              ]
                            }
                          }
                        }
                      }
                    }
                  }
                ]
              }
            }
          },
          "definition": {
            "$ref": "#/definitions/service"
          },
          "publication": {
            "enum": [
              "ready",
              "published",
              "retired"
            ]
          }
        }
      }
    },
    "dataApprovals": {
      "type": "object"
    },
    "issuer": {
      "type": "string",
      "pattern": "^https://[a-z0-9.-]+/realms/applications$"
    },
    "telemetry": {
      "type": "boolean"
    },
    "argo-cd": {
      "type": "object"
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "previewWaypoint": {
          "type": "boolean"
        },
        "previewIdentity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "instance": {
              "type": "string",
              "pattern": "^[a-f0-9]{32}$"
            },
            "approvalDigest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "runtimeStateUID": {
              "type": "string",
              "pattern": "^[a-z0-9-]{1,64}$"
            }
          },
          "required": [
            "instance",
            "approvalDigest",
            "runtimeStateUID"
          ]
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,40}$",
          "not": {
            "const": "default"
          }
        },
        "owner": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,40}$"
        },
        "image": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9./:_-]+@sha256:[a-f0-9]{64}$"
        },
        "replicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "artifactPolicyHash": {
          "type": "string",
          "pattern": "^([a-f0-9]{64})?$"
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true
        },
        "ports": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,40}$"
              },
              "port": {
                "type": "integer",
                "minimum": 1024,
                "maximum": 65535
              }
            },
            "required": [
              "name",
              "port"
            ]
          },
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true
        },
        "health": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "readiness": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^/[A-Za-z0-9/_-]*$"
                },
                "port": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,40}$"
                }
              },
              "required": [
                "path",
                "port"
              ]
            },
            "liveness": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^/[A-Za-z0-9/_-]*$"
                },
                "port": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,40}$"
                }
              },
              "required": [
                "path",
                "port"
              ]
            }
          },
          "required": [
            "readiness",
            "liveness"
          ]
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requests": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "cpu": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]{0,3}m$"
                },
                "memory": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]{0,4}Mi$"
                }
              },
              "required": [
                "cpu",
                "memory"
              ]
            },
            "limits": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "cpu": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]{0,3}m$"
                },
                "memory": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]{0,4}Mi$"
                }
              },
              "required": [
                "cpu",
                "memory"
              ]
            }
          },
          "required": [
            "requests",
            "limits"
          ]
        },
        "environment": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "secrets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,40}$"
              },
              "mountPath": {
                "type": "string",
                "pattern": "^/(secrets|config|tls)/[a-z0-9-]+$"
              }
            },
            "required": [
              "name",
              "mountPath"
            ]
          },
          "minItems": 0,
          "maxItems": 16,
          "uniqueItems": true
        },
        "configMaps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,40}$"
              },
              "mountPath": {
                "type": "string",
                "pattern": "^/(secrets|config|tls)/[a-z0-9-]+$"
              }
            },
            "required": [
              "name",
              "mountPath"
            ]
          },
          "minItems": 0,
          "maxItems": 16,
          "uniqueItems": true
        },
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "size": {
              "type": "string",
              "pattern": "^[1-9][0-9]?Gi$"
            },
            "mountPath": {
              "type": "string",
              "pattern": "^/data(/[a-z0-9-]+)?$"
            },
            "retention": {
              "const": "retain"
            }
          },
          "required": [
            "enabled",
            "size",
            "mountPath",
            "retention"
          ]
        },
        "exposure": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "class": {
                  "const": "none"
                }
              },
              "required": [
                "class"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "class": {
                  "enum": [
                    "public",
                    "private"
                  ]
                },
                "hostname": {
                  "type": "string",
                  "pattern": "^[a-z0-9.-]+$"
                },
                "access": {
                  "enum": [
                    "public",
                    "human",
                    "machine",
                    "tailnet"
                  ]
                },
                "path": {
                  "type": "string",
                  "pattern": "^/[A-Za-z0-9/_-]*$"
                },
                "port": {
                  "type": "integer",
                  "minimum": 1024,
                  "maximum": 65535
                }
              },
              "required": [
                "class",
                "hostname",
                "access",
                "path",
                "port"
              ]
            }
          ]
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "database": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,62}$"
                },
                "credentialReference": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,40}$"
                },
                "retention": {
                  "const": "retain"
                }
              },
              "required": [
                "name",
                "credentialReference",
                "retention"
              ]
            },
            "bucket": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,40}$"
                },
                "credentialReference": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,40}$"
                },
                "retention": {
                  "const": "retain"
                }
              },
              "required": [
                "name",
                "credentialReference",
                "retention"
              ]
            }
          },
          "required": []
        },
        "oidc": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "const": false
                }
              },
              "required": [
                "enabled"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "const": true
                },
                "realm": {
                  "const": "applications"
                },
                "client": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,40}$"
                },
                "public": {
                  "type": "boolean"
                },
                "callbackPaths": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^/[A-Za-z0-9/_-]*$"
                  },
                  "minItems": 1,
                  "maxItems": 8,
                  "uniqueItems": true
                },
                "audience": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,40}$"
                },
                "scopes": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "profile",
                      "email"
                    ]
                  },
                  "minItems": 1,
                  "maxItems": 2,
                  "uniqueItems": true
                },
                "roleMapping": {
                  "type": "object",
                  "minProperties": 1,
                  "maxProperties": 8,
                  "propertyNames": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{0,40}$"
                  },
                  "additionalProperties": {
                    "type": "array",
                    "items": {
                      "enum": [
                        "platform-admin",
                        "developer",
                        "viewer"
                      ]
                    },
                    "minItems": 1,
                    "maxItems": 3,
                    "uniqueItems": true
                  }
                },
                "secretReference": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,40}$"
                }
              },
              "required": [
                "enabled",
                "realm",
                "client",
                "public",
                "callbackPaths",
                "audience",
                "scopes",
                "roleMapping"
              ]
            }
          ]
        },
        "monitoring": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "const": false
            }
          },
          "required": [
            "enabled"
          ]
        },
        "rollouts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "required": [
            "enabled"
          ]
        },
        "initCommand": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string"
          }
        },
        "global": {
          "type": "object",
          "additionalProperties": false
        },
        "additionalExposures": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "class": {
                "const": "private"
              },
              "hostname": {
                "type": "string",
                "pattern": "^[a-z0-9.-]+$"
              },
              "access": {
                "enum": [
                  "public",
                  "human",
                  "machine",
                  "tailnet"
                ]
              },
              "path": {
                "type": "string",
                "pattern": "^/[A-Za-z0-9/_-]*$"
              },
              "port": {
                "type": "integer",
                "minimum": 1024,
                "maximum": 65535
              }
            },
            "required": [
              "class",
              "hostname",
              "access",
              "path",
              "port"
            ]
          },
          "uniqueItems": true
        },
        "renderDisabled": {
          "type": "boolean"
        },
        "imagePullSecrets": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "const": "harbor-application-pull"
              }
            }
          }
        },
        "routeOnly": {
          "type": "boolean"
        },
        "routeBackends": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "service",
              "port",
              "selector"
            ],
            "properties": {
              "service": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,30}$"
              },
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "selector": {
                "type": "object",
                "minProperties": 1,
                "maxProperties": 8,
                "additionalProperties": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9._-]{1,63}$"
                }
              },
              "readiness": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "statuses"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "pattern": "^/[a-zA-Z0-9/_-]{0,127}$"
                  },
                  "statuses": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 6,
                    "uniqueItems": true,
                    "items": {
                      "enum": [
                        200,
                        204,
                        400,
                        401,
                        403
                      ]
                    }
                  }
                }
              }
            }
          },
          "minProperties": 0,
          "maxProperties": 8,
          "propertyNames": {
            "pattern": "^[a-z0-9][a-z0-9.-]{0,251}[a-z0-9]$"
          }
        }
      },
      "required": [
        "name",
        "owner",
        "image",
        "replicas",
        "command",
        "ports",
        "health",
        "resources",
        "environment",
        "secrets",
        "configMaps",
        "persistence",
        "exposure",
        "data",
        "oidc",
        "monitoring",
        "rollouts",
        "initCommand"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#",
      "allOf": [
        {
          "if": {
            "properties": {
              "exposure": {
                "properties": {
                  "class": {
                    "const": "none"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "additionalExposures": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    }
  }
}
