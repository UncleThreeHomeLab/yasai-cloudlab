{
  "type": "object",
  "required": ["arc", "eligibility"],
  "allOf": [{"if": {"required": ["policyName"], "properties": {"policyName": {"const": "cloudlab-ci-eligibility-publish"}}},
             "then": {"properties": {"manageSharedResources": {"const": false}}}}],
  "anyOf": [{"properties": {"eligibility": {"minItems": 1}}},
            {"required": ["workflowTemplates"], "properties": {"workflowTemplates": {"minItems": 1}}}],
  "properties": {
    "testing": {
      "type": "object", "additionalProperties": false, "required": ["image"],
      "properties": {"image": {"type": "string", "pattern": "^[a-z0-9.-]+/cloudlab-public/[a-z0-9][a-z0-9._/-]{0,180}@sha256:[a-f0-9]{64}$"}}
    },
    "publishing": {
      "type": "object", "additionalProperties": false,
      "required": ["application", "source_repository", "source_repository_id", "visibility", "registry", "project", "release_repository", "release_repository_id", "workflow_identity"],
      "properties": {
        "application": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,34}$"},
        "source_repository": {"type": "string", "pattern": "^[A-Za-z0-9-]+/[A-Za-z0-9_.-]+$"},
        "source_repository_id": {"type": "string", "pattern": "^[1-9][0-9]{0,19}$"},
        "visibility": {"enum": ["public", "private"]},
        "registry": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,252}$"},
        "project": {"enum": ["cloudlab-public", "cloudlab-private"]},
        "release_repository": {"type": "string", "pattern": "^[A-Za-z0-9-]+/[A-Za-z0-9_.-]+$"},
        "release_repository_id": {"type": "integer", "minimum": 1},
        "workflow_identity": {"type": "string", "pattern": "^https://github[.]com/[A-Za-z0-9-]+/[A-Za-z0-9_.-]+/[.]github/workflows/(application-publish[.]yaml@[a-f0-9]{40}|ci[.]yaml@refs/heads/main)$"}
      }
    },
    "manageSharedResources": {"type": "boolean"},
    "policyName": {"type": "string", "enum": ["cloudlab-ci-eligibility", "cloudlab-ci-eligibility-publish"]},
    "workflowTemplates": {
      "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["repository_id", "repository", "workflow_path", "workflow_sha256", "job", "visibility", "job_workflow_ref"],
        "properties": {
          "repository_id": {"type": "string", "pattern": "^[1-9][0-9]{0,19}$"},
          "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
          "workflow_path": {"const": ".github/workflows/ci.yaml"},
          "workflow_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "job_workflow_ref": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/[.]github/workflows/(application-(test|publish)[.]yaml@[a-f0-9]{40}|ci[.]yaml@refs/heads/main)$"},
          "job": {"enum": ["test", "build", "publish"]},
          "visibility": {"enum": ["public", "private"]}
        }
      }
    },
    "eligibility": {
      "type": "array", "minItems": 0, "maxItems": 16, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["repository_id", "repository", "workflow_ref", "workflow_sha", "sha", "ref", "event_name", "job"],
        "properties": {
          "repository_id": {"type": "string", "pattern": "^[1-9][0-9]{0,19}$"},
          "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
          "workflow_ref": {"type": "string", "maxLength": 256, "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/[.]github/workflows/[A-Za-z0-9_.-]+[.]ya?ml@refs/(heads/main|pull/[1-9][0-9]*/merge)$"},
          "workflow_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
          "sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
          "ref": {"type": "string", "pattern": "^refs/(heads/main|pull/[1-9][0-9]*/merge)$"},
          "event_name": {"enum": ["push", "workflow_dispatch", "pull_request"]},
          "job": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,63}$"}
        },
        "allOf": [{"if": {"properties": {"event_name": {"const": "pull_request"}}},
                   "then": {"properties": {"job": {"const": "test"}, "ref": {"pattern": "^refs/pull/[1-9][0-9]*/merge$"}}},
                   "else": {"properties": {"ref": {"const": "refs/heads/main"}}}}]
      }
    },
    "arc": {
      "type": "object",
      "required": ["githubConfigUrl", "githubConfigSecret", "minRunners", "maxRunners", "template"],
      "properties": {
        "githubConfigUrl": {"type": "string", "pattern": "^https://github[.]com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "githubConfigSecret": {"enum": ["github-arc", "github-arc-public"]},
        "minRunners": {"const": 0},
        "maxRunners": {"const": 1},
        "template": {
          "type": "object",
          "properties": {
            "spec": {
              "type": "object",
              "properties": {
                "containers": {
                  "type": "array", "minItems": 1, "maxItems": 1,
                  "items": {
                    "type": "object", "required": ["name", "image"],
                    "properties": {
                      "name": {"const": "runner"},
                      "image": {"type": "string", "pattern": "^[a-z0-9.-]+/cloudlab-public/ci-runner@sha256:[a-f0-9]{64}$"}
                    }
                  }
                },
                "initContainers": {
                  "type": "array", "minItems": 1, "maxItems": 1,
                  "items": {
                    "type": "object", "required": ["name", "image"],
                    "properties": {
                      "name": {"const": "builder"},
                      "image": {"type": "string", "pattern": "^[a-z0-9.-]+/cloudlab-public/ci-builder@sha256:[a-f0-9]{64}$"}
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
