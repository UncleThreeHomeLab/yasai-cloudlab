{
  "type": "object",
  "required": ["arc"],
  "allOf": [
    {"if": {"required": ["registration"]}, "then": {},
     "else": {"properties": {"arc": {"properties": {"image": {"properties": {
       "repository": {"type": "string", "pattern": "^[a-z0-9.-]+/cloudlab-public/ci-controller$"},
       "tag": {"type": "string", "pattern": "^0[.]15[.]0@sha256:[a-f0-9]{64}$"}}}}}}}}
  ],
  "properties": {
    "component": {"type": "string", "const": "controller"},
    "images": {"type": "object"},
    "registration": {
      "type": "object",
      "required": ["application", "source", "ci"],
      "properties": {
        "application": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,34}$"},
        "source": {
          "type": "object",
          "required": ["repository", "repositoryId", "visibility"],
          "properties": {
            "repository": {"type": "string", "pattern": "^[A-Za-z0-9-]+/[A-Za-z0-9_.-]+$"},
            "repositoryId": {"type": "string", "pattern": "^[1-9][0-9]{0,19}$"},
            "visibility": {"enum": ["public", "private"]}
          }
        },
        "ci": {
          "type": "object",
          "required": ["profile", "approval", "jobs"],
          "properties": {
            "profile": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$"},
            "approval": {
              "type": "object",
              "required": ["revision"],
              "properties": {
                "revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
                "pullRequest": {"type": "integer", "minimum": 1}
              }
            },
            "jobs": {
              "type": "object",
              "required": ["test"],
              "properties": {"test": {"type": "boolean"}, "publish": {"type": "boolean"}}
            }
          }
        },
        "publishing": {"type": "object"}
      }
    },
    "applicationCapacity": {"type": "integer", "minimum": 1, "maximum": 8},
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enforce", "apiServiceCIDRs", "apiEndpointCIDRs", "registryCIDRs"],
      "properties": {
        "enforce": {"type": "boolean"},
        "apiServiceCIDRs": {"$ref": "#/definitions/hosts"},
        "apiEndpointCIDRs": {"$ref": "#/definitions/hosts"},
        "registryCIDRs": {"$ref": "#/definitions/hosts"}
      }
    },
    "manageSystemNamespace": {"type": "boolean"},
    "runnerPools": {"type": "integer", "minimum": 1, "maximum": 2},
    "arc": {
      "type": "object",
      "required": ["image", "flags", "replicaCount"],
      "properties": {
        "replicaCount": {"const": 1},
        "image": {
          "type": "object",
          "required": ["repository", "tag"],
          "properties": {
            "repository": {"type": "string"},
            "tag": {"type": "string"}
          }
        },
        "flags": {
          "type": "object",
          "required": ["watchSingleNamespace"],
          "properties": {"watchSingleNamespace": {"type": "string", "pattern": "^(?:cloudlab-ci-private|cloudlab-ci-(?:private|public)-[a-z0-9][a-z0-9-]{0,35})$"}}
        }
      }
    }
  },
  "definitions": {
    "hosts": {"type": "array", "maxItems": 4, "uniqueItems": true, "items": {
      "type": "string", "pattern": "^(?:10[.][0-9]{1,3}[.][0-9]{1,3}[.][0-9]{1,3}|172[.](?:1[6-9]|2[0-9]|3[01])[.][0-9]{1,3}[.][0-9]{1,3}|192[.]168[.][0-9]{1,3}[.][0-9]{1,3}|100[.](?:6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])[.][0-9]{1,3}[.][0-9]{1,3})/32$"
    }}
  }
}
