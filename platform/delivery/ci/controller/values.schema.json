{
  "type": "object",
  "required": ["arc"],
  "properties": {
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enforce", "apiServiceCIDRs", "apiEndpointCIDRs", "registryCIDRs"],
      "properties": {
        "enforce": {"type": "boolean"},
        "apiServiceCIDRs": {"$ref": "#/definitions/hosts"},
        "apiEndpointCIDRs": {"$ref": "#/definitions/hosts"},
        "registryCIDRs": {"$ref": "#/definitions/hosts"}
      }
    },
    "manageSystemNamespace": {"type": "boolean"},
    "runnerPools": {"type": "integer", "minimum": 1, "maximum": 2},
    "arc": {
      "type": "object",
      "required": ["image", "flags", "replicaCount"],
      "properties": {
        "replicaCount": {"const": 1},
        "image": {
          "type": "object",
          "required": ["repository", "tag"],
          "properties": {
            "repository": {"type": "string", "pattern": "^[a-z0-9.-]+/cloudlab-public/ci-controller$"},
            "tag": {"type": "string", "pattern": "^0[.]15[.]0@sha256:[a-f0-9]{64}$"}
          }
        },
        "flags": {
          "type": "object",
          "required": ["watchSingleNamespace"],
          "properties": {"watchSingleNamespace": {"type": "string", "pattern": "^(?:cloudlab-ci-private|cloudlab-ci-(?:private|public)-[a-z0-9][a-z0-9-]{0,35})$"}}
        }
      }
    }
  },
  "definitions": {
    "hosts": {"type": "array", "maxItems": 4, "uniqueItems": true, "items": {
      "type": "string", "pattern": "^(?:10[.][0-9]{1,3}[.][0-9]{1,3}[.][0-9]{1,3}|172[.](?:1[6-9]|2[0-9]|3[01])[.][0-9]{1,3}[.][0-9]{1,3}|192[.]168[.][0-9]{1,3}[.][0-9]{1,3}|100[.](?:6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])[.][0-9]{1,3}[.][0-9]{1,3})/32$"
    }}
  }
}
