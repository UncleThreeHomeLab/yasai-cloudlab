{
  "type": "object",
  "required": ["arc"],
  "properties": {
    "manageSystemNamespace": {"type": "boolean"},
    "runnerPools": {"type": "integer", "minimum": 1, "maximum": 2},
    "arc": {
      "type": "object",
      "required": ["image", "flags", "replicaCount"],
      "properties": {
        "replicaCount": {"const": 1},
        "image": {
          "type": "object",
          "required": ["repository", "tag"],
          "properties": {
            "repository": {"type": "string", "pattern": "^[a-z0-9.-]+/cloudlab-public/ci-controller$"},
            "tag": {"type": "string", "pattern": "^0[.]15[.]0@sha256:[a-f0-9]{64}$"}
          }
        },
        "flags": {
          "type": "object",
          "required": ["watchSingleNamespace"],
          "properties": {"watchSingleNamespace": {"type": "string", "pattern": "^(?:cloudlab-ci-private|cloudlab-ci-(?:private|public)-[a-z0-9][a-z0-9-]{0,35})$"}}
        }
      }
    }
  }
}
