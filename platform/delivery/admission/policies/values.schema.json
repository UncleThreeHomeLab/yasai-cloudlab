{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["validationActions"],
  "properties": {
    "validationActions": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "items": {"enum": ["Audit", "Warn", "Deny"]},
      "not": {"allOf": [{"contains": {"const": "Warn"}}, {"contains": {"const": "Deny"}}]}
    }
  }
}
