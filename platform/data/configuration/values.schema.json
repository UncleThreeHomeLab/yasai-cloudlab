{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "s3Host",
    "database",
    "applicationRole",
    "migrationRole",
    "backupRole",
    "bucket",
    "maintenance",
    "postgresImage"
  ],
  "properties": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "database",
        "role"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "database": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,62}$",
          "allOf": [
            {
              "not": {
                "pattern": "^pg_"
              }
            },
            {
              "not": {
                "enum": [
                  "postgres",
                  "template0",
                  "template1"
                ]
              }
            }
          ]
        },
        "role": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,62}$",
          "allOf": [
            {
              "not": {
                "pattern": "^pg_"
              }
            },
            {
              "not": {
                "enum": [
                  "postgres",
                  "template0",
                  "template1"
                ]
              }
            }
          ]
        }
      }
    },
    "s3Host": {
      "type": "string",
      "pattern": "^s3\\.internal\\.[a-z0-9.-]+$",
      "maxLength": 253
    },
    "database": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,62}$",
      "allOf": [
        {
          "not": {
            "pattern": "^pg_"
          }
        },
        {
          "not": {
            "enum": [
              "postgres",
              "template0",
              "template1"
            ]
          }
        }
      ]
    },
    "applicationRole": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,62}$",
      "allOf": [
        {
          "not": {
            "pattern": "^pg_"
          }
        },
        {
          "not": {
            "enum": [
              "postgres",
              "template0",
              "template1"
            ]
          }
        }
      ]
    },
    "migrationRole": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,62}$",
      "allOf": [
        {
          "not": {
            "pattern": "^pg_"
          }
        },
        {
          "not": {
            "enum": [
              "postgres",
              "template0",
              "template1"
            ]
          }
        }
      ]
    },
    "backupRole": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,62}$",
      "allOf": [
        {
          "not": {
            "pattern": "^pg_"
          }
        },
        {
          "not": {
            "enum": [
              "postgres",
              "template0",
              "template1"
            ]
          }
        }
      ]
    },
    "bucket": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,61}[a-z0-9]$"
    },
    "maintenance": {
      "type": "boolean"
    },
    "hibernated": {
      "type": "boolean"
    },
    "postgresImage": {
      "const": "ghcr.io/cloudnative-pg/postgresql:18.4-standard-trixie@sha256:ebf3919504d7523a63e8e2fee9b051211de714644b36469275558c624afd50ec"
    },
    "serviceRequests": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "service": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,30}$"
          },
          "namespace": {
            "type": "string",
            "pattern": "^cloudlab-app-[a-z0-9-]+$"
          },
          "database": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,62}$",
                "allOf": [
                  {
                    "not": {
                      "pattern": "^pg_"
                    }
                  },
                  {
                    "not": {
                      "enum": [
                        "postgres",
                        "template0",
                        "template1"
                      ]
                    }
                  }
                ]
              },
              "applicationRole": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,62}$",
                "allOf": [
                  {
                    "not": {
                      "pattern": "^pg_"
                    }
                  },
                  {
                    "not": {
                      "enum": [
                        "postgres",
                        "template0",
                        "template1"
                      ]
                    }
                  }
                ]
              },
              "migrationRole": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,62}$",
                "allOf": [
                  {
                    "not": {
                      "pattern": "^pg_"
                    }
                  },
                  {
                    "not": {
                      "enum": [
                        "postgres",
                        "template0",
                        "template1"
                      ]
                    }
                  }
                ]
              },
              "applicationItem": {
                "type": "string",
                "pattern": "^cnpg-[a-z0-9-]+-production$"
              },
              "migrationItem": {
                "type": "string",
                "pattern": "^cnpg-[a-z0-9-]+-migration$"
              }
            },
            "required": [
              "name",
              "applicationRole",
              "migrationRole",
              "applicationItem",
              "migrationItem"
            ]
          },
          "bucket": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{1,61}[a-z0-9]$"
              },
              "item": {
                "type": "string",
                "pattern": "^s3-[a-z0-9-]+-production$"
              }
            },
            "required": [
              "name",
              "item"
            ]
          }
        },
        "required": [
          "service",
          "namespace"
        ]
      },
      "uniqueItems": true
    },
    "serviceConsumers": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^cloudlab-app-[a-z][a-z0-9-]{0,30}$"
      }
    },
    "sharedInputs": {
      "type": "boolean"
    },
    "zone": {
      "type": "string",
      "maxLength": 253,
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)+$"
    },
    "production": {
      "type": "boolean"
    },
    "storageClass": {
      "const": "cloudlab-data"
    },
    "provisioner": {
      "const": "driver.longhorn.io"
    },
    "reclaimPolicy": {
      "const": "Retain"
    },
    "volumeBindingMode": {
      "const": "Immediate"
    },
    "replicas": {
      "const": 2
    },
    "fsType": {
      "const": "ext4"
    },
    "ordinaryBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claims",
        "storageGi"
      ],
      "properties": {
        "claims": {
          "const": 2
        },
        "storageGi": {
          "const": 4
        }
      }
    },
    "retention": {
      "const": "retain"
    },
    "dataApprovals": {
      "type": "object",
      "maxProperties": 40,
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "service",
              "name",
              "item",
              "migrationItem"
            ],
            "properties": {
              "kind": {
                "const": "database"
              },
              "service": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,30}$"
              },
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,62}$",
                "allOf": [
                  {
                    "not": {
                      "pattern": "^pg_"
                    }
                  },
                  {
                    "not": {
                      "enum": [
                        "postgres",
                        "template0",
                        "template1"
                      ]
                    }
                  }
                ]
              },
              "item": {
                "type": "string",
                "pattern": "^cnpg-[a-z0-9-]+-production$"
              },
              "migrationItem": {
                "type": "string",
                "pattern": "^cnpg-[a-z0-9-]+-migration$"
              },
              "applicationRole": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,62}$",
                "allOf": [
                  {
                    "not": {
                      "pattern": "^pg_"
                    }
                  },
                  {
                    "not": {
                      "enum": [
                        "postgres",
                        "template0",
                        "template1"
                      ]
                    }
                  }
                ]
              },
              "migrationRole": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,62}$",
                "allOf": [
                  {
                    "not": {
                      "pattern": "^pg_"
                    }
                  },
                  {
                    "not": {
                      "enum": [
                        "postgres",
                        "template0",
                        "template1"
                      ]
                    }
                  }
                ]
              }
            },
            "dependencies": {
              "applicationRole": [
                "migrationRole"
              ],
              "migrationRole": [
                "applicationRole"
              ]
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "service",
              "name",
              "item"
            ],
            "properties": {
              "kind": {
                "const": "bucket"
              },
              "service": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,30}$"
              },
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{1,61}[a-z0-9]$"
              },
              "item": {
                "type": "string",
                "pattern": "^s3-[a-z0-9-]+-production$"
              }
            }
          }
        ]
      }
    },
    "catalog": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "definition",
          "approval",
          "publication"
        ],
        "properties": {
          "definition": {
            "type": "object",
            "required": [
              "data"
            ],
            "properties": {
              "data": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "database": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "name",
                      "credentialReference",
                      "retention"
                    ],
                    "properties": {
                      "name": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_]{0,62}$",
                        "allOf": [
                          {
                            "not": {
                              "pattern": "^pg_"
                            }
                          },
                          {
                            "not": {
                              "enum": [
                                "postgres",
                                "template0",
                                "template1"
                              ]
                            }
                          }
                        ]
                      },
                      "credentialReference": {
                        "type": "string",
                        "minLength": 1
                      },
                      "retention": {
                        "const": "retain"
                      }
                    }
                  },
                  "bucket": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "name",
                      "credentialReference",
                      "retention"
                    ],
                    "properties": {
                      "name": {
                        "type": "string",
                        "pattern": "^[a-z0-9][a-z0-9-]{1,61}[a-z0-9]$"
                      },
                      "credentialReference": {
                        "type": "string",
                        "minLength": 1
                      },
                      "retention": {
                        "const": "retain"
                      }
                    }
                  }
                }
              }
            }
          },
          "approval": {
            "type": "object",
            "required": [
              "name",
              "namespace"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,30}$"
              },
              "namespace": {
                "type": "string",
                "pattern": "^cloudlab-app-[a-z][a-z0-9-]{0,30}$"
              }
            }
          },
          "publication": {
            "enum": [
              "ready",
              "published",
              "retired"
            ]
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "sharedInputs"
        ],
        "properties": {
          "sharedInputs": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "zone",
          "production",
          "catalog",
          "dataApprovals"
        ]
      }
    }
  ]
}
