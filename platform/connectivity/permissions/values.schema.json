{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mode",
    "context",
    "permissions"
  ],
  "properties": {
    "mode": {
      "enum": [
        "profiles",
        "bindings"
      ]
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "revision",
        "namespace",
        "commitment"
      ],
      "properties": {
        "repository": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        },
        "namespace": {
          "type": "string"
        },
        "commitment": {
          "type": "string"
        }
      }
    },
    "permissions": {}
  }
}
