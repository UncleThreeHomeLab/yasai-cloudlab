{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "zone",
    "proxyImage"
  ],
  "properties": {
    "zone": {
      "type": "string",
      "maxLength": 253,
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)+$"
    },
    "proxyImage": {
      "const": "docker.io/istio/proxyv2:1.31.1@sha256:d86cba0dd1eb15c00b6901c69ce5ae3d2d5f8427a47751098cf8c3ab2a4a62e9"
    },
    "argo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "public": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]+$"
        },
        "private": {
          "type": "string",
          "pattern": "^cd[.]internal[.][a-z0-9][a-z0-9.-]+$"
        }
      }
    },
    "sharedInputs": {
      "type": "boolean"
    },
    "production": {
      "type": "boolean"
    },
    "argo-cd": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configs"
      ],
      "properties": {
        "configs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cm",
            "rbac"
          ],
          "properties": {
            "cm": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "url",
                "additionalUrls",
                "users.session.duration",
                "oidc.config"
              ],
              "properties": {
                "url": {
                  "type": "string",
                  "minLength": 1
                },
                "additionalUrls": {
                  "type": "string",
                  "minLength": 1
                },
                "users.session.duration": {
                  "type": "string",
                  "minLength": 1
                },
                "oidc.config": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "rbac": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "policy.default",
                "scopes",
                "policy.csv"
              ],
              "properties": {
                "policy.default": {
                  "type": "string",
                  "minLength": 1
                },
                "scopes": {
                  "type": "string",
                  "minLength": 1
                },
                "policy.csv": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "sharedInputs"
        ],
        "properties": {
          "sharedInputs": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "production",
          "argo-cd"
        ]
      }
    }
  ]
}
